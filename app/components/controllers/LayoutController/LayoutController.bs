import "pkg:/components/_ord/init.bs"


sub init()
    exec(sub(_options = {})
        subscribe({
            [events.CATALOG_HERO_FOCUSED]: onCatalogHeroFocused,
            [events.CATALOG_CAROUSELS_FOCUSED]: onCatalogCarouselsFocused,
            [events.CAROUSEL_ITEM_FOCUSED]: onCarouselItemFocused,
            [events.ERROR_GO_BACK]: errorGoBack,
            [events.ERROR_PREPARE_CRASH]: initiateCrash,
            [events.HERO_ITEM_FOCUSED]: onHeroItemFocused,
            [events.NAVIGATE_TO]: navigateTo,
            [events.REMOVE_BACKGROUND]: removeBackground,
            [events.SCREEN_ACTIVE]: onScreenActive,
            [events.SET_NEW_BACKGROUND]: onHeroItemFocused,
            [events.SET_USER_CAROUSELS]: setUserCarousels,
            [events.SHOW_CATALOG_UI]: showCatalogUI,
            [events.SHOW_CONTENT_UI]: showContentUI
        })
    end sub)
end sub


sub errorGoBack(_options = {})
    exec("goBack", { error: true }, layout())
end sub


sub initiateCrash(_options = {})
    exec("initiateCrash", { error: true }, layout())
end sub


sub onCarouselItemFocused(options = {})
    exec("updateHeaderAssets", options, layout())
    exec("setComplimentaryColor", options, background())
end sub


sub navigateTo(options = {})
    slug = options.slug ?? ""
    activeSlug = get("activeSlug") ?? ""
    if activeSlug = slug then return

    exec("navigateTo", options, layout())
end sub


sub onCatalogCarouselsFocused(options = {})
    exec("catalogCarouselsFocused", options, layout())
end sub


sub onCatalogHeroFocused(options = {})
    exec("catalogHeroFocused", options, layout())
end sub


sub onHeroItemFocused(options = {})
    exec("updateBackgroundAssets", options, layout())
end sub


sub onScreenActive(options = {})
    exec("setActiveView", options, layout())
    exec("setActiveSlug", options, sidebar())
    set({ "activeSlug": options.slug ?? "" })
end sub


sub removeBackground(options = {})
    exec("removeBackground", options, background())
end sub


sub setUserCarousels(options = {})
    exec("setUserCarousels", options, topbar())
end sub


sub showCatalogUI(_options = {})
    exec("showCatalogUI", {}, layout())
end sub


sub showContentUI(_options = {})
    exec("showContentUI", {}, layout())
end sub


function background()
    return findNode("background")
end function


function catalogHeader()
    return findNode("catalogHeader")
end function


function layout()
    return findNode("layout")
end function


function sidebar()
    return findNode("sidebar")
end function


function topbar()
    return findNode("topbar")
end function


function findNode(nodeId)
    return app().findNode(nodeId)
end function
