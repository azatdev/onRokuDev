import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub(options = {})
        subscribe({
            [events.APP_STARTED]: onAppStarted,
            [events.CATALOG_HERO_FOCUSED]: onCatalogHeroFocused,
            [events.CAROUSEL_ITEM_FOCUSED]: onCarouselItemFocused,
            [events.GET_SCREEN_DATA]: getScreenData,
            [events.GET_SIDEBAR]: getSidebar,
            [events.GET_TOPBAR]: getTopbar,
            [events.HERO_ITEM_FOCUSED]: updateBackgroundAssets,
            [events.NAVIGATE_TO]: navigateTo,
            [events.PAGINATE_CAROUSEL]: paginateCarousel,
            [events.PAGINATE_SCREEN]: getScreenData,
            [events.SCREEN_DATA_RECEIVED]: onScreenDataReceived,
            [events.SCROLL_GROUP_FOCUSED]: onScrollGroupFocused,
            [events.SIDEBAR_RECEIVED]: onSidebarReceived,
            [events.TOPBAR_RECEIVED]: onTopbarReceived
        })
    end sub)
end sub


sub onAppStarted(options = {})
    dispatch(events.GET_SIDEBAR)
    dispatch(events.GET_TOPBAR)
end sub


sub onCarouselItemFocused(options = {})
    if not rodash.isNonEmptyAA(options) then return
    itemHeader = catalogHeader()
    if not rodash.isNode(itemHeader) then return
    itemHeader.data = options

    updateBackgroundAssets(options)
end sub


sub updateBackgroundAssets(options = {})
    if rodash.isEmpty(options) then return
    appBackground = background()
    if rodash.isEmpty(appBackground) then return
    exec("updateAssets", options, background())
end sub


sub getScreenData(options = {})
    if not rodash.isNonEmptyAA(options) then return

    slug = options.slug ?? ""
    screenId = options.screenId ?? ""
    collection = options.collection
    screenConfig = get(slug) ?? {}

    if not rodash.isNode(collection)
        documentId = screenConfig.documentId ?? ""
        collection = createObject("roSGNode", "Collection")
        collection.update({
            documentId: documentId,
            screenId: screenId,
            slug: slug
        }, true)
    end if

    collection.paginating = true

    screenConfig.collection = collection
    saveObject = {}
    saveObject[slug] = screenConfig
    set(saveObject)

    screenTask = createObject("roSGNode", "ScreenTask")
    screenTask.update({ collection: collection
    }, true)
    screenTask.control = "RUN"
end sub


sub getSidebar(options = {})
    if rodash.isInvalid(m.sidebarTask) then m.sidebarTask = createObject("roSGNode", "SidebarTask")
    m.sidebarTask.control = "RUN"
end sub


sub getTopbar(options = {})
    if rodash.isInvalid(m.topbarTask) then m.topbarTask = createObject("roSGNode", "TopbarTask")
    m.topbarTask.control = "RUN"
end sub


sub navigateTo(options = {})
    documentId = options.documentId
    slug = options.slug

    screenConfig = get(slug) ?? {}
    ' screenVariables = screenConfig.variables ?? {}
    ' screenVariables.setModeCaseSensitive()
    screenConfig["documentId"] = documentId
    ' screenConfig.variables = screenVariables

    saveObject = {}
    saveObject[slug] = screenConfig
    set(saveObject)

    exec("navigateTo", options, layout())
end sub


sub onCatalogHeroFocused(options = {})
    exec("showBackground", options, background())
    exec("hideHeaderImage", options, background())
end sub


sub onScrollGroupFocused(options = {})
    exec("hideBackground", options, background())
    exec("showHeaderImage", options, background())
end sub


sub onScreenDataReceived(options = {})
    if not rodash.isNonEmptyAA(options) then return

    screenModel = options.content
    if not rodash.isNode(screenModel) then return

    screenId = screenModel.screenId ?? ""
    if rodash.isEmpty(screenId) then return

    screen = layout().findNode(screenId)
    if not rodash.isNode(screen) then return

    ' screenConfig.totalCount = screenModel.totalCount
    if rodash.isEmpty(screen.data)
        screen.data = {
            content: screenModel
        }
    end if
end sub


sub onSidebarReceived(options = {})
    sidebar().data = options
end sub


sub onTopbarReceived(options = {})
    topbar().data = options
end sub


sub paginateCarousel(options = {})
    if not rodash.isNonEmptyAA(options) then return
    collection = options.collection
    collection.paginating = true

    paginationTask = createObject("roSGNode", "PaginationTask")

    paginationTask.update({
        options: {
            collection: collection
        }
    }, true)

    paginationTask.control = "RUN"
end sub


function background()
    return findNode("background")
end function


function catalogHeader()
    return findNode("catalogHeader")
end function


function layout()
    return findNode("layout")
end function


function sidebar()
    return findNode("sidebar")
end function


function topbar()
    return findNode("topbar")
end function


function findNode(nodeId)
    node = m[nodeId]
    if rodash.isInvalid(node) then node = app().findNode(nodeId)
    m[nodeId] = node
    return node
end function
