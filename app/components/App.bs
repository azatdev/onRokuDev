        "defaultVisibleIndex": 1,
        "direction": "horizontal",
        "duration": 0.5,
        "flushFocus": false,
        "focusType": "floating",
        "gutterWidth": 0,
        "itemComponentName": "TestItem",
        "margin": [9, 0],
        "smallSquare": [212, 273],
