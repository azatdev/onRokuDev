import "pkg:/components/_ord/wrappers.bs"
import "testdata.bs"


sub init()
    exec(sub()
        top().setFocus(true)

        m.sidebar = top().findNode("sidebar")
        m.topbar = top().findNode("topbar")
        m.ctas = top().findNode("ctas")
        m.defaultCarousel = top().findNode("defaultCarousel")
        m.dynamicCarousel = top().findNode("dynamicCarousel")
        m.flushCarousel = top().findNode("flushCarousel")
        m.scrollGroup = top().findNode("scrollGroup")
        m.scrollGroup.config = {
            flushEnd: true
        }

        registerControllers([
            "SocketController"
            "StylesController"
        ])

        setFocusMap({
            "ctas": {
                "down": m.dynamicCarousel,
                "up": "topbar",
                "left": "sidebar"
            },
            "dynamicCarousel": {
                "down": "defaultCarousel",
                "up": "ctas",
                "left": "sidebar"
            },
            "defaultCarousel": {
                "down": "flushCarousel",
                "up": "dynamicCarousel",
                "left": "sidebar"
            },
            "flushCarousel": {
                "down": "flushCarousel",
                "up": "defaultCarousel",
                "left": "sidebar"
            },
            "topbar": {
                "down": "ctas"
            },
            "sidebar": {
                "right": "ctas"
            }
        })

        rodash.delay(sub(node)
            node.setFocus(true)
            ' m.scrollGroup.setFocus(true)
        end sub, 100, m.scrollGroup)

        ' rodash.delay(sub(node)
        '     newRect = createObject("roSGNode", "Rectangle")
        '     newRect.width = 1650
        '     newRect.height = 400
        '     newRect.color = "#0000FFFF"

        '     newRect2 = createObject("roSGNode", "Rectangle")
        '     newRect2.width = 1650
        '     newRect2.height = 200
        '     newRect2.color = "#FF00FFFF"
        '     node.appendChildren([newRect, newRect2])
        '     ' node.appendChild(newRect)
        ' end sub, 7000, m.scrollGroup)
    end sub)
end sub


function onTheNose(options = {})
    return { result: options.name + " success" }
end function


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        if not press then return true
        ?"onKeyEvent " key
        handled = processFocus(key)
        return handled
    end function, { key: key, press: press })
end function
