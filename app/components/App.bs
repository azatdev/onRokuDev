sub loadThirdList(options = {})
    list = createObject("roSGNode", "_ord_flexList")
    list.id = "third_list"
    top().appendChild(list)

    testModel = returnDynamicWidthModel()
    testModel.addField("rectConfig", "assocarray", true)
    testModel.addField("totalCount", "integer", false)

    testModel.id = "flexDynamicCarousel_model"
    testModel.totalCount = testModel.getChildCount()
    m.dynamicModel = testModel

    testModel.rectConfig = {
        ' direction: "vertical",
        animationDuration: 0.1,
        horizAlign: "left",
        ' vertAlign: "top",
        carouselType: "dynamicSize",
        clip: true,
        defaultVisibleIndex: 0,
        dynamicWidth: true,
        focusType: "floating",
        itemComponentName: "DynamicItem",
        visibleTiles: 999,
        wrap: true,
        flushFocus: true,
        maxWidth: 720,
        bigSquare: [200, 100],
        gutterSize: 30,
        smallSquare: [200, 100],
        squareMargins: [6, 0]
        ' squareMargins: [0, 6]
    }

    list.data = {
        content: testModel
    }

    m.thirdList = list
    m.thirdList.setFocus(true)
end sub


function returnModel(options = {})
    numberOfModels = options.number
    testModel = createObject("roSGNode", "ContentNode")
    for i = 1 to numberOfModels
        testModel.update([
            { id: i, subtype: "ContentNode" },
        ])
    end for
    return testModel
end function


function returnDynamicWidthModel()
    testModel = createObject("roSGNode", "ContentNode")
    titles = ["Home", "Live Channels", "Documentaries", "TV Shows", "Movies", "Sports", "News", "Favorites", "Settings", "Account", "Terms of Service"]
    for each item in titles
        childModel = createObject("roSGNode", "ContentNode")
        childModel.title = item
        testModel.appendChild(childModel)
    end for

    return testModel
end function


function onTheNose(options = {})
    return { result: options.name + " success" }
end function


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        m = getGlobalAA()
        if not press then return true

        ?"key " key

        if key = "back" then m.container.setFocus(true)
        if key = "replay" then m.firstList.setFocus(true)
        if key = "up" then m.thirdList.setFocus(true)
        if key = "down" then m.secondList.setFocus(true)

        return true
    end function, { key: key, press: press })
end function
