sub loadRectTest()
    rect1 = createObject("roSGNode", "Rectangle")
    rect1.id = "rect1"
    rect2 = createObject("roSGNode", "Rectangle")
    rect2.id = "rect2"
    ' rect1.appendChild(rect2)
    ?"insertingChildren " rodash.now()
    top().insertChild(rect1, 0)
    ?"insertingChildren 2 " rodash.now()
    top().insertChild(rect2, 0)
end sub


sub loadList(options = {})
    list = createObject("roSGNode", "_ord_flexList")
    list.id = "first_list"
    top().appendChild(list)

    testModel = returnModel({ number: 8 })
    testModel.addField("rectConfig", "assocarray", true)
    testModel.addField("totalCount", "integer", false)

    testModel.rectConfig = {
        ' direction: "vertical",
        animationDuration: 0.3,
        ' horizAlign: "right",
        ' vertAlign: "top",
        carouselType: "default",
        clip: true,
        defaultVisibleIndex: 0,
        focusType: "floating",
        itemComponentName: "TestItem",
        visibleTiles: 4,
        wrap: true,
        flushFocus: false,
        bigSquare: [210, 210],
        ' gutterSize: [0],
        gutterSize: [75, 0],
        ' gutterSize: [0, 75],
        smallSquare: [150, 150],
        squareMargins: [0]
    }

    testModel.id = "flexCarousel_model"
    testModel.totalCount = testModel.getChildCount()

    list.data = {
        content: testModel
    }

    m.firstList = list
    m.firstList.setFocus(true)
end sub


