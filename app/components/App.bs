import "pkg:/components/_ord/wrappers.bs"
import "testdata.bs"


sub init()
    exec(sub()
        top().setFocus(true)

        m.sidebar = top().findNode("sidebar")
        m.topbar = top().findNode("topbar")
        m.ctas = top().findNode("ctas")
        m.defaultCarousel = top().findNode("defaultCarousel")
        m.dynamicCarousel = top().findNode("dynamicCarousel")
        m.flushCarousel = top().findNode("flushCarousel")

        registerControllers([
            "SocketController"
            "StylesController"
        ])

        rodash.delay(sub(node)
            node.setFocus(true)
        end sub, 100, m.ctas)
    end sub)
end sub


function onTheNose(options = {})
    return { result: options.name + " success" }
end function


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        m = getGlobalAA()
        if not press then return true

        if key = "up"
            if m.sidebar.isInFocusChain() then return true
            if m.ctas.isInFocusChain() then m.topbar.setFocus(true)
            if m.dynamicCarousel.isInFocusChain() then m.ctas.setFocus(true)
            if m.defaultCarousel.isInFocusChain() then m.dynamicCarousel.setFocus(true)
            if m.flushCarousel.isInFocusChain() then m.defaultCarousel.setFocus(true)
        else if key = "down"
            if m.sidebar.isInFocusChain() then return true
            if m.defaultCarousel.isInFocusChain() then m.flushCarousel.setFocus(true)
            if m.dynamicCarousel.isInFocusChain() then m.defaultCarousel.setFocus(true)
            if m.ctas.isInFocusChain() then m.dynamicCarousel.setFocus(true)
            if m.topbar.isInFocusChain() then m.ctas.setFocus(true)
        else if key = "left"
            if not m.sidebar.isInFocusChain() then m.sidebar.setFocus(true)
        else if key = "right"
            if m.sidebar.isInFocusChain() then m.ctas.setFocus(true)
        end if

        return true
    end function, { key: key, press: press })
end function
