import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub(_options = {})
        subscribe({
            [events.EVENT_TASK_READY]: onEventTaskReady
        })

        m.layout = top().findNode("layout")

        setFocusMap({
            "onFocus": m.layout,
            "app": {
                "default": true
            }
        })

        registerControllers([
            "ConfigsController",
            "LayoutController",
            "PlayerController",
            "SocketController",
            "StylesController",
            "UserController"
        ])
    end sub)
end sub


sub onEventTaskReady(_options = {})
    dispatch(events.APP_STARTED)
end sub
