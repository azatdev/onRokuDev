import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub(_options = {})
        subscribe({
            [events.EVENT_TASK_READY]: onEventTaskReady
        })

        m.layout = top().findNode("layout")
        if not rodash.isNode(m.layout) then setFocus(m.layout)

        registerControllers([
            "ConfigsController",
            "LayoutController",
            "PlayerController",
            "SFXController",
            "SocketController",
            "StylesController",
            "UserController"
        ])
    end sub)
end sub


sub onEventTaskReady(_options = {})
    dispatch(events.APP_STARTED)
end sub
