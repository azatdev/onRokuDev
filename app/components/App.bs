import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub(_options = {})
        top().setFocus(true)

        subscribe({
            [events.EVENT_TASK_READY]: onEventTaskReady
        })

        m.layout = top().findNode("layout")
        m.layout.setFocus(true)

        registerControllers([
            "ConfigsController",
            "LayoutController",
            "PlayerController",
            "SFXController",
            "SocketController",
            "StylesController",
            "UserController"
        ])
    end sub)
end sub


sub onEventTaskReady(_options = {})
    dispatch(events.APP_STARTED)
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        if not press then return true
        handled = processFocus(key)
        ?"App onKeyEvent " key, handled
        return handled
    end function, { key: key, press: press })
end function
