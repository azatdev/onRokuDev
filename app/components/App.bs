import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub(_options = {})
        top().setFocus(true)

        subscribe({
            [events.EVENT_TASK_READY]: onEventTaskReady
        })

        m.layout = top().findNode("layout")
        m.layout.setFocus(true)

        registerControllers([
            "ConfigsController",
            "LayoutController",
            "PlayerController",
            "SFXController",
            "SocketController",
            "StylesController",
            "UserController"
        ])
    end sub)
end sub


sub onEventTaskReady(_options = {})
    dispatch(events.APP_STARTED)
end sub
