    exec(sub()
        ?"INIT " m.top.subtype()
        ' m.secondNode = createObject("roSGNode", "SecondNode")

        ' m.secondNode.data = {
        '     azat: "is cool"
        ' }

        ' localResult = onTheNose({ name: "Azat" })
        ' remoteResult = exec("onTheNose", { name: "Azat" }, m.secondNode)
        ' ?"localResult " localResult
        ' ?"remoteResult " remoteResult

        ' set({
        '     "food": "burrito"
        '     "drink": "diet dr pepper"
        ' })

        ' ?"get self " get("food")
        ' ?"get self 2" get(["food", "drink"])
        ' ?"get self 3 " top().drink

        ' set({
        '     "food": "pizza"
        ' }, m.secondNode)

        ' ?"get remote " get("food", m.secondNode)
        ' res2 = get(["food", "someArray"], m.secondNode)
        ' ?"get remote 2 " res2 res2.someArray

        registerControllers([
            "SocketController"
            "StylesController"
        ])

        ?"FRIENDS "
        ?get("asd")

        top().setFocus(true)
        loadList()
        loadSecondList()

    end sub)
end sub


sub loadList(options = {})
    rectConfig = {
        "autoclip": true,
        "bigSquare": [252, 321],
        "defaultVisibleIndex": 1,
        "direction": "horizontal",
        "duration": 0.3,
        "flushFocus": false,
        "focusType": "floating",
        "gutterSize": 0,
        "itemComponentName": "TestItem",
        "margin": [0],
        "smallSquare": [213, 273],
        ' "horizAlign": "left",
        ' "vertAlign": "top",
        "visibleTiles": 4,
        "wrap": true
    }

    list = createObject("roSGNode", "MagicList")
    top().appendChild(list)

    testModel = returnModel({ number: 6 })

    list.content = testModel
    list.rectConfig = rectConfig
    list.color = "#FFFFFF00"
    m.firstList = list
    ' list.setFocus(true)
end sub


sub loadSecondList(options = {})
    list = createObject("roSGNode", "_ord_flexList")
    top().appendChild(list)

    testModel = returnModel({ number: 11 })
    testModel.addField("rectConfig", "assocarray", true)
    testModel.addField("totalCount", "integer", false)

    testModel.rectConfig = {
        direction: "horizontal",
        animationDuration: 0.1,
        clip: true,
        defaultVisibleIndex: 1,
        focusType: "floating",
        itemComponentName: "TestItem",
        visibleTiles: 4,
        wrap: true,
        bigSquare: [252, 321],
        gutterSize: 0,
        smallSquare: [213, 273],
        squareMargins: [0]
    }

    testModel.id = "flexCarousel_model"
    testModel.totalCount = testModel.getChildCount()

    list.data = {
        content: testModel
    }

    m.secondList = list
    list.setFocus(true)
end sub


function returnModel(options = {})
    numberOfModels = options.number
    testModel = createObject("roSGNode", "ContentNode")
    for i = 1 to numberOfModels
        testModel.appendChild(createObject("roSGNode", "ContentNode"))
    end for
    return testModel
end function


function onTheNose(options = {})
    return { result: options.name + " success"  }
end function

function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        m = getGlobalAA()
        if not press then return true

        if key = "down" then m.secondList.setFocus(true)
        if key = "up" then m.firstList.setFocus(true)

        return true
    end function, { key: key, press: press })
end function
