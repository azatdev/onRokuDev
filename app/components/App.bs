sub loadCTAs()
    list = createObject("roSGNode", "_ord_flexList")
    list.id = "ctas_list"
    m.container.appendChild(list)

    ctasModel = createObject("roSGNode", "CTAsModel")
    ctasModel.id = "flexDynamicCarousel_model"
    ctasModel.totalCount = ctasModel.getChildCount()

    ctasModel.rectConfig = {
        carouselType: "dynamicSize",
        focusType: "floating",
        itemComponentName: "ButtonItem",
        maxWidth: 1800,
        visibleTiles: 999,
        bigSquare: [200, 100],
        smallSquare: [200, 100],
        squareMargins: [0, 16, 0, 0]
    }

    list.data = {
        content: ctasModel
    }
    m.ctaList = list

    list.setFocus(true)
end sub


sub loadList(options = {})
    list = createObject("roSGNode", "_ord_flexList")
    list.id = "first_list"
    m.container.appendChild(list)

    testModel = createObject("roSGNode", "DefaultCarouselModel")

    testModel.rectConfig = {
        ' direction: "vertical",
        animationDuration: 0.3,
        ' horizAlign: "right",
        ' vertAlign: "top",
        carouselType: "default",
        clip: true,
        defaultVisibleIndex: 0,
        focusType: "fixed",
        itemComponentName: "CarouselItem",
        visibleTiles: 5,
        wrap: true,
        bigSquare: [336, 189],
        ' gutterSize: [0],
        gutterSize: [153, 0],
        ' gutterSize: [0, 75],
        smallSquare: [288, 162],
        squareMargins: [0]
    }

    testModel.id = "flexCarousel_model"
    testModel.totalCount = testModel.getChildCount()

    list.data = {
        content: testModel
    }

    m.firstList = list
    ' m.firstList.setFocus(true)
end sub


