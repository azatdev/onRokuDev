sub loadList()
    rectConfig = {
        "autoclip": true,
        "bigSquare": [251, 321],
        "defaultVisibleIndex": 1,
        "direction": "horizontal",
        "duration": 0.5,
        "flushFocus": false,
        "focusType": "floating",
        "gutterWidth": 0,
        "itemComponentName": "TestItem",
        "margin": [9, 0],
        "smallSquare": [212, 273],
        "visibleTiles": 4,
        "wrap": true
    }

    list = createObject("roSGNode", "MagicList")
    m.top.appendChild(list)

    testModel = createObject("roSGNode", "ContentNode")
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))
    testModel.appendChild(createObject("roSGNode", "ContentNode"))

    list.content = testModel
    list.rectConfig = rectconfig
    list.color = "#FFFFFF00"
    list.translation = [399,198]
    list.setFocus(true)
end sub


sub applyStyles(appStyles = {})
    exec("setStyles", appStyles.App)
end sub


function returnHandles(options = {})
    allNodeHandles = []

    node = options.node
    if not rodash.isNode(node) then return allNodeHandles

    nodeSubtype = node.subType()
    if not nodeSubtype = "Group" and not node.isSubtype("Group") then return allNodeHandles

    allNodeHandles.push(nodeSubtype)

    if rodash.isNonEmptyString(node.class) then allNodeHandles.push(`${nodeSubtype}.${node.class}`)

    if rodash.isNonEmptyString(node.id) then allNodeHandles.push(`${nodeSubtype}#${node.id}`)

    if rodash.isNonEmptyString(node.id) and rodash.isNonEmptyString(node.class) then allNodeHandles.push(`${nodeSubtype}#${node.id}.${node.class}`)

    return allNodeHandles
end function
