import "pkg:/components/_ord/init.bs"

sub init()
    exec(sub(_options = {})
        m.paginationConfigs = "{{%- o(CONFIG.Pagination) %}}"
        safeFunctions({
            "generateDefaultModels": generateDefaultModels,
            "getChildFields": getChildFields,
            "getVariables": getVariables,
            "processCarouselData": processCarouselData,
            "returnInitialPagination": returnInitialPagination
        })
    end sub)
end sub


sub generateDefaultModels(_options = {})
    initialPagination = returnInitialPagination()

    ' Load initial carousel items
    ' for loading animation
    for x = 0 to initialPagination.pageSize - 1
        updateObject = {
            description: "",
            id: "pending",
            hydrated: false,
            logoImageUri: "",
            thumbnailImageUri: ""
        }
        model = createObject("roSGNode", "ContentModel")
        model.update(updateObject, true)

        top().appendChild(model)
    end for
end sub


function getChildFields(options = {})
    childIds = []
    fieldToGet = options.field ?? "id"

    for each child in top().getChildren(-1, 0)
        childIds.push(child[fieldToGet])
    end for

    return childIds
end function


function getPagination(_options = {})
    existingPagination = top().pagination
    if rodash.isNonEmptyAA(existingPagination)
        newPagination = returnSubsequentPagination()
        newPagination.start = top().totalCount
    else
        newPagination = returnInitialPagination()
    end if

    top().pagination = newPagination

    return newPagination
end function


sub processCarouselData(options = {})
    children = options.children ?? []
    for each child in children
        documentId =  child.id ?? ""
        if rodash.isEmptyString(documentId) then continue for

        contentNode = top().findNode(documentId) ?? top().findNode("pending")

        if not rodash.isNode(contentNode)
            contentNode = createObject("roSGNode", "ContentModel")
            top().appendChild(contentNode)
        end if

        contentNode.update(child, true)
        contentNode.hydrated = true
    end for

    top().canPaginate = not rodash.isEmpty(children)
    removePendingNodes()
    top().hydrated = true
end sub


function returnInitialPagination(_options = {})
    if top().carouselType = carouselTypes.HERO
        return m.paginationConfigs["HeroInitial"]
    else if top().carouselType = carouselTypes.SCREEN
        return m.paginationConfigs["ScreenInitial"]
    else
        return m.paginationConfigs["Initial"]
    end if
end function


function returnSubsequentPagination(_options = {})
    if top().carouselType = carouselTypes.HERO
        return m.paginationConfigs["HeroSubsequent"]
    else if top().carouselType = carouselTypes.SCREEN
        return m.paginationConfigs["ScreenSubsequent"]
    else
        return m.paginationConfigs["Subsequent"]
    end if
end function


function getVariables(_options = {})
    returnObj = {}
    returnObj.setModeCaseSensitive()
    returnObj["documentId"] = top().id
    returnObj["pagination"] = getPagination()
    return returnObj
end function


sub removePendingNodes()
    pendingNode = top().findNode("pending")

    while pendingNode <> invalid
        top().removeChild(pendingNode)
        pendingNode = top().findNode("pending")
    end while
end sub

