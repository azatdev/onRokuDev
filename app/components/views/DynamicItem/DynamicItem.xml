<?xml version="1.0" encoding="utf-8" ?>
<component name="DynamicItem" extends="Rectangle">
    <interface>
        <field id="index" type="integer" />
        <field id="currRect" type="rect2d" />
        <field id="focusPercent" type="float" />
        <field id="itemContent" type="node" onChange="itemContentChanged" />
        <function name="safeFunc" />
    </interface>
    <children>
        <Poster id="container">
            <Quantico id="label" />
        </Rectangle>
    </children>
    <script type="text/brightscript" uri="DynamicItem.bs" />
</component>
