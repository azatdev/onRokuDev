<?xml version="1.0" encoding="utf-8" ?>
<component name="CarouselItem" extends="Div">
    <interface>
        <field id="index" type="integer" />
        <field id="content" type="node" />
        <field id="currRect" type="rect2d" />
        <field id="focusPercent" type="float" />
        <field id="loaded" type="boolean" />
        <field id="itemContent" type="node" />
        <function name="safeFunc" />
    </interface>
    <children>
        <Div id="container">
            <Poster id="thumbnail" />
            <Poster id="outline" />
        </Div>
    </children>
    <script type="text/brightscript" uri="CarouselItem.bs" />
</component>
