import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub(options = {})
        top().id = "carouselItem"
        setupItem()
    end sub)
end sub


sub setupItem()
    m.indexLabel = top().findNode("label")
    m.container = top().findNode("container")
    m.container.addField("loaded", "boolean", false)
    m.outline = top().findNode("outline")
    m.outline.visible = false
    m.thumbnail = top().findNode("thumbnail")
    setLoadable({ node: m.container, updateField: "loaded" })
    safeObserve("currRect", onCurrentRectChange)
    safeObserve("focusPercent", onFocusPercentChange)
    safeObserve("itemContent", itemContentChanged)
    safeObserve("loadStatus", onThumbnailLoadStatus, m.thumbnail)
end sub


sub itemContentChanged(options = {})
    content = options.data
    if content = invalid then return
    if rodash.isNode(m.content) then return

    m.content = content

    if rodash.isNonEmptyString(content.thumbnailImageUri)
        setThumbailImage({ data: content.thumbnailImageUri })
    else
        safeObserve("thumbnailImageUri", setThumbailImage, m.content)
    end if
end sub


sub onCurrentRectChange(options = {})
    rect = options.data ?? {}

    width = int(rect.width / 3) * 3
    height = int(rect.height / 3) * 3

    top().height = height
    top().width = width

    if rodash.isNode(m.container)
        m.container.height = height
        m.container.width = width
    end if

    if rodash.isNode(m.outline)
        m.outline.height = height
        m.outline.width = width
    end if

    if rodash.isNode(m.thumbnail)
        m.thumbnail.height = height - 12
        m.thumbnail.width = width - 12
    end if
end sub


sub onFocusPercentChange(options = {})
    focusPercentage = options.data ?? {}
    ' opacityPercentage = (0.5 * focusPercentage) * focusPercentage + 0.5
    ' m.container.opacity = opacityPercentage
end sub


sub onThumbnailLoadStatus(options)
    if not rodash.isNonEmptyAA(options) then return
    loadStatus = options.data ?? ""
    if loadStatus <> "ready" then return
    if not rodash.isNode(m.outline) then return
    m.outline.visible = true
end sub


sub setThumbailImage(options = {})
    thumbnailImageUrl = options.data ?? ""
    if rodash.isEmptyString(thumbnailImageUrl) then return
    m.thumbnail.uri = thumbnailImageUrl
    m.container.loaded = true
end sub
