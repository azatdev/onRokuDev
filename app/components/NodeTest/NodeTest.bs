import "pkg:/source/wrapperFunctions.bs"
import "pkg:/source/helpers/appUtils.bs"


sub init()
    subscribe({
        "TEST_EVENT": "onTestEvent"
    })
end sub


sub onTestEvent(data, msgInfo)
    ?"onTestEventasdfasdf " data msgInfo.timespan.totalMilliseconds()

    exec("testFunction", { demand: "MOAR PIZZA" }, app())
end sub
