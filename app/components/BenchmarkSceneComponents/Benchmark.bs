import "pkg:/source/helpers/typeGuard.bs"
' import "pkg:/components/_ord/azat.bs"
import "tests/AAvsRef.bs"
import "tests/CallFuncVsSafeFunc.bs"
import "tests/CallfuncObserve.bs"
import "tests/DataRetrieval.bs"
import "tests/GroupVsRectangle.bs"
import "tests/ImportsVsNoImports.bs"
import "tests/DataSending.bs"
import "tests/MtopVsM.bs"
import "tests/NodeRefFuncVsLocal.bs"
import "tests/TryCatch.bs"
import "tests/NodeInitiation.bs"
import "tests/ObserveUnobserve.bs"


sub init(options = {})
    m.top.observeFieldScoped("run", "onRun")
    m.top.observeFieldScoped("resultsText", "printResults")

    m.benchmarks = {
        "AAvsRef": AAvsRef
        "CallfuncObserve": CallfuncObserve
        "CallFuncVsSafeFunc": CallFuncVsSafeFunc
        "DataRetrieval": DataRetrieval
        "DataSending": DataSending
        "GroupVsRectangle": GroupVsRectangle
        "ImportsVsNoImports": ImportsVsNoImports
        "MtopVsM": MtopVsM
        "NodeInitiation": NodeInitiation
        "NodeRefFuncVsLocal": NodeRefFuncVsLocal
        "ObserveUnobserve": ObserveUnobserve
        "TryCatch": TryCatch
    }
end sub


sub observeHelper(event)
    ?"event " event
end sub

sub onRun(event = {})
    if not TypeGuard_isEvent(event) then return

    devMode = true

    sleep(1000)

    if devMode
        doRun(event)
    else
        try
            doRun(event)
        catch e
            ?"Error: " e
        end try
    end if
end sub


sub doRun(event)
    data = event.getData()
    funcName = data[0] ?? ""
    funcOptions = data[1] ?? {}

    benchClass = m.benchmarks[funcName]
    m.benchmark = new benchClass()
    m.benchmark.start(funcOptions)
end sub


function testFunc()
    m.benchmark.changeString2()
end function


sub printResults(event)
    testMessage = ""
    testMessage += chr(10)
    testMessage += "+-+-+-+-+-+-+-+-+-+-+-+-+-+"
    testMessage += chr(10)
    testMessage += chr(10)
    testMessage += "BENCHMARK RESULTS:"
    testMessage += chr(10)
    testMessage += chr(10)
    testMessage += event.getData()
    testMessage += chr(10)
    testMessage += chr(10)
    testMessage += "-+-+-+-+-+-+-+-+-+-+-+-+-+-"
    testMessage += chr(10)
    ?testMessage
end sub
