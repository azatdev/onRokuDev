class MtopVsM
    sub new()
        m.benchTimer = CreateObject("roTimespan")
    end sub

    sub start(options = {})
        for each item in options.items()
            m[item.key] = item.value
        end for

        m.benchmark1()
    end sub

    sub end()
        m.benchTimer.mark()
        for ix = 0 to 999
            m.top.removeField(`field-${ix}`)
        end for

        ?"end1 " + m.benchTimer.totalMilliseconds().toStr()

        m.benchTimer.mark()
        for ix = 0 to 999
            m.delete(`field-${ix}`)
        end for

        ?"end2 " + m.benchTimer.totalMilliseconds().toStr()
    end sub

    sub benchmark1()
        m.benchTimer.mark()

        for ix = 0 to 999
            m.top.addField(`field-${ix}`, "integer", false)
        end for

        ?"benchmark1 " + m.benchTimer.totalMilliseconds().toStr()
        m.benchmark2()
    end sub

    sub benchmark2()
        m.benchTimer.mark()

        for ix = 0 to 999
            m[`field-${ix}`] = 0
        end for

        ?"benchmark2 " + m.benchTimer.totalMilliseconds().toStr()
        m.benchmark3()
    end sub

    sub benchmark3()
        m.benchTimer.mark()

        for ix = 0 to 999
            m.top[`field-${ix}`] = ix
        end for

        ?"benchmark3 " + m.benchTimer.totalMilliseconds().toStr()
        m.benchmark4()
    end sub

    sub benchmark4()
        m.benchTimer.mark()

        for ix = 0 to 999
            m[`field-${ix}`] = ix
        end for

        ?"benchmark4 " + m.benchTimer.totalMilliseconds().toStr()
        m.end()
    end sub
end class
