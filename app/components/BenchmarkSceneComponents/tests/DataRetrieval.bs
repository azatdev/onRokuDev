    sub new()
        m.benchTimer = createObject("roTimespan")
        m.receiverNode = createObject("roSGNode", "DataReceiver")
        m.logText = []
        m.iterations = 499
    end sub


    sub start(options = {})
        for each item in options.items()
            m[item.key] = item.value
        end for

        m.benchmark1()
    end sub


    sub end(options = {})
        m.top.resultsText = m.logText.join(chr(10))
    end sub


    sub benchmark1()
        m.benchTimer.mark()

        for ix = 0 to m.iterations
            m.receiverNode.data = m.testJSON
        end for

        m.logText.push(`ObserveField took ${m.benchTimer.totalMilliseconds().toStr()} ms`)

        m.benchmark2()
    end sub


    sub benchmark2()
        m.benchTimer.mark()

        for ix = 0 to m.iterations
            m.receiverNode.callFunc("getData", m.testJSON)
        end for

        m.logText.push(`CallFunc took ${m.benchTimer.totalMilliseconds().toStr()} ms`)

        m.benchmark3()
    end sub


    sub benchmark3()
        m.benchTimer.mark()
        m.receiverNode.setRef("dataRef", m.testJSON)

        for ix = 0 to m.iterations
            m.receiverNode.setRef("dataRef", m.testJSON)
            m.receiverNode.callFunc("getRef")
        end for

        m.logText.push(`set and get ref took ${m.benchTimer.totalMilliseconds().toStr()} ms`)

        m.end()
    end sub

end class
