<?xml version="1.0" encoding="utf-8" ?>
<component name="HelperNode" extends="Node">
    <interface>
        <field id="data" type="assocArray" />
        <field id="active" type="boolean" />

        <!-- Advertising metadata (VOD & EPG) -->
        <field id="adConfiguration" type="assocarray" />

        <field id="adSlots" type="array" />

        <field id="badges" type="array" />

        <field id="channelData" type="assocArray" />

        <!-- User type restrictions on EPG channels -->
        <field id="channelAvailability" type="assocArray" />

        <!-- EPG Channel ID -->
        <field id="channelId" type="string" />

        <field id="clickTrackingJson" type="assocarray" />

        <!-- Filterable credits, not passing roles returns all roles -->
        <field id="contributors" type="array" />  <!-- Roles([ContributorRole!]): [Contributor!]! -->

        <!-- copyright year; year video was first released -->
        <field id="copyrightYear" type="string" />
        <field id="ctvFillImage" type="string" />

        <!-- default duration of up next display before auto navigation to asset -->
        <field id="countdownTimeMS" type="integer"  />

        <field id="cwPosition" type="integer" />

        <!-- Analytics metadata key-values for screen-level data -->
        <field id="detailPageAnalyticsMetadata" type="array" />

        <field id="details" type="string" />  <!-- ContentDetailsCollection -->

        <field id="detailsNavigation" type="node" />  <!-- ListContentCollection -->

        <field id="duration" type="integer" />

        <!-- EPG Category ID -->
        <field id="epgCategoryId" type="string" />

        <field id="episodeTitle" type="string" />

        <!-- List of ids of available episodes after actual one. For next episode purpose in the CDS -->
        <field id="playlist" type="array" />

        <field id="endDate" type="string" />

        <field id="episodeNum" type="integer" />

        <field id="extraVideos" type="array" />

        <field id="parentId" type="string" /> <!-- For extras, get the id of the parent content -->

        <!-- For extras, get parent information as is needed for Watchlist  -->
        <field id="parentBadges" type="array" />

        <field id="parentStreamAvailability" type="assocArray" />

        <field id="extraType" type="string" /> <!-- For extras, this coudl be either TRAILER or BEHIND_THE_SCENES -->

        <field id="featuredUri" type="string" />

        <!-- Genres -->
        <field id="genres" type="stringarray" />  <!-- [String!]! -->

        <field id="heroContentType" type="string" />

        <field id="heroPosterUri" type="string" />

        <field id="horizontalHeroUri" type="string" />

        <field id="horizontalPosterUri" type="string" />

        <field id="verticalPosterUri" type="string" />

        <!--  -->
         <field id="hasReverseOrder" type="boolean" />

        <field id="index" type="integer" />

        <field id="introEndPosition" type="integer" />

        <field id="introSkippable" type="boolean" />

        <field id="introStartPosition" type="integer" />

        <field id="isContinueWatchingRow" type="boolean" />

        <field id="isWatchlistRow" type="boolean" />

        <field id="isEPG" type="boolean" />

        <field id="isKids" type="boolean" />

        <field id="isSubscriber" type="boolean" />

        <field id="isMovie" type="boolean" />

        <field id="isNews" type="boolean" />

        <field id="isNovela" type="boolean" />

        <field id="isPlaylist" type="boolean" />

        <field id="isReplay" type="boolean" />

        <field id="isSerie" type="boolean" />

        <field id="isSports" type="boolean" />

        <!-- Primary language of source video -->
        <field id="language" type="string" />  <!-- String -->

        <field id="liveSportsEvent" type="boolean" />

        <field id="moreContentCollection" type="node" />

        <field id="newSeries" type="boolean" />

        <field id="newsFullEpisode" type="boolean" />

        <field id="opacity" type="float" value="1" />
        <!--  -->

        <field id="outroSkippable" type="boolean" />

        <field id="outroStartPosition" type="integer" />

        <field id="playerModel" type="node" />

        <field id="playerPremiumCTA" type="string" />

        <field id="position" type="integer" />

        <field id="posterUri" type="string" />

        <field id="posterBlurUri" type="string" />

        <field id="progress" type="float" />

        <field id="rating" type="string" />

        <field id="ratingValue" type="string" />

        <field id="requiresSubscription" type="boolean" />

        <field id="rowTitle" type="string" />

        <field id="rowTrackingJson" type="assocArray" />

        <field id="seasonId" type="string" />

        <field id="sharedMetadataJson" type="assocarray" />

        <field id="seasonTitle" type="string" />

        <field id="seasonsCount" type="integer" />

        <field id="seriesEpisodesCount" type="integer" />

        <field id="seriesScreenDetailPageAnalyticsMetadata" type="array" />

        <!-- set only if videoType === "SERIES"  -->
        <field id="dateOnTitle" type="boolean" />

        <field id="seriesSubType" type="string" />

        <field id="seriesId" type="string" />

        <field id="seriesBadges" type="array" />

        <field id="seriesTitle" type="string" />

        <field id="seriesDescription" type="string" />

        <field id="shortCode" type="string" />

        <field id="snapshotPosterUri" type="string" />

        <field id="sponsorMetadata" type="assocArray" />

        <!-- set only if videoType === "SPORTS"  -->
        <field id="sportsEndDate" type="string" />

        <field id="sportsStartDate" type="string" />

        <field id="startDate" type="string" />

        <!-- GEO and time window restrictions on EPG programs and VOD content -->
        <field id="streamAvailability" type="assocArray" />

        <field id="streamURL" type="string" />

        <!-- HERO to Target -->
        <field id="target" type="assocarray" />

        <field id="titleEp" type="string" />

        <field id="titlePosterUri" type="string" />

        <field id="treatment" type="string" />

        <field id="type" type="string" />
    </interface>
    <children>

    </children>
    <script type="text/brightscript" uri="HelperNode.bs" />
</component>