import "pkg:/components/_ord/wrappers.bs"
import "pkg:/source/roku_modules/sgrouter/router.brs"

sub init()
    exec(sub(_options = {})
        m.background = top().findNode("background")
        m.navigation = top().findNode("navigation")
        m.topbar = top().findNode("topbar")
        m.sidebar = top().findNode("sidebar")
        m.screenContainer = top().findNode("screenContainer")
        m.videoPlayer = top().findNode("videoPlayer")
        sgrouter.initialize({ outlet: m.screenContainer })

        sgRouter.addRoutes([
            { pattern: "/home", component: "CatalogScreen", suspendMode: "visible" },
            ' { pattern: "/shows", component: "CatalogScreen", clearStackOnResolve: true },
            ' { pattern: "/movies", component: "CatalogScreen", clearStackOnResolve: true },
            { pattern: "/content/:id", component: "ContentScreen", "suspendMode": "visible" },
            { pattern: "/details/:id", component: "DetailsModal", "suspendMode": "visible" },
            ' { pattern: "/:screenName", component: "DefaultScreen" }
        ])

        safeFunctions({
            "showContentUI": showContentUI,
            "showCatalogUI": showCatalogUI,
            "navigateTo": navigateTo,
            "playVideo": playVideo
        })

        setFocusMap({
            "default": m.screenContainer,
            "sidebar": {
                "right": focusOnScreen
            },
            "topbar": {
                "down": focusOnScreen,
                "left": m.sidebar
            },
            "videoPlayer": {
                "back": hideVideoPlayer
            }
        })

        set({
            catalogUIHidden: false,
            contentUIHidden: true,
            navigationHidden: false
        })

        safeObserve("routerState", onRouterStateChanged, sgRouter.getRouter())
        safeObserve("focusedChild", onFocusedChildChange)
    end sub)
end sub


sub showCatalogUI(options = {})
    if get("navigationHidden")
        set({ navigationHidden: false })
        fadeIn(m.navigation, { duration: 1 })
    end if

    if get("catalogUIHidden")
        set({ catalogUIHidden: false, contentUIHidden: true })
        exec("showCatalogGradients", options, m.background)
        exec("hideContentGradients", options, m.background)
    end if
end sub


sub showContentUI(options = {})
    if not get("navigationHidden")
        set({ navigationHidden: true })
        fadeOut(m.navigation, { duration: 1 })
    end if

    if get("contentUIHidden")
        set({ catalogUIHidden: true, contentUIHidden: false })
        exec("hideCatalogGradients", options, m.background)
        exec("showContentGradients", options, m.background)
    end if
end sub


sub navigateTo(options = {})
    if not rodash.isNonEmptyAA(options) then return

    slug = options.slug ?? ""
    if rodash.isEmptyString(slug) then return

    sgRouter.navigateTo(slug, { context: options })
end sub


sub onFocusedChildChange(options = {})
    if not rodash.isNonEmptyAA(options) then return
    focusedChild = options.data
    if not rodash.isNode(focusedChild) or not top().isSameNode(focusedChild) then return
    focusOnScreen()
end sub


sub focusOnScreen(_options = {})
    activeView = m.activeView
    if not rodash.isNode(activeView) then return
    setFocus(m.activeView)
end sub


sub onRouterStateChanged(options = {})
    data = options.data
    if data.type <> "NavigationEnd" then return
    setActiveView(data.id)
end sub


sub hideVideoPlayer(_options = {})
    morphObject = {}
    morphObject[m.videoPlayer.id] = {
        fields: {
            opacity: 0
        }
    }
    morphObject[m.screenContainer.id] = {
        fields: {
            opacity: 1
        }
    }
    morphObject[m.background.id] = {
        fields: {
            opacity: 1
        }
    }

    if get("contentUIHidden")
        morphObject[m.navigation.id] = {
            fields: {
                opacity: 1
            }
        }
    end if

    morph(morphObject)
    focusOnScreen()
end sub


sub playVideo(options = {})
    if not rodash.isNode(m.videoPlayer) then return
    m.videoPlayer.data = options
    morphObject = {}
    morphObject[m.videoPlayer.id] = {
        fields: {
            opacity: 1
        }
    }
    morphObject[m.screenContainer.id] = {
        fields: {
            opacity: 0
        }
    }
    morphObject[m.background.id] = {
        fields: {
            opacity: 0
        }
    }
    morphObject[m.navigation.id] = {
        fields: {
            opacity: 0
        }
    }
    morph(morphObject)
    setFocus(m.videoPlayer)
end sub


sub setActiveView(screenId = "")
    if rodash.isEmptyString(screenId) then return
    m.activeView = top().findNode(screenId)
    mapObject = {}

    viewMapObject = {
        "left": m.sidebar,
        "up": m.topbar
    }
    mapObject[screenId] = viewMapObject
    setFocusMap(mapObject)
    setFocus(m.activeView)
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        if not press then return true
        handled = processFocus(key)
        ?"Layout onKeyEvent " key, handled
        return handled
    end function, { key: key, press: press })
end function
