import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub(_options = {})
        m.carouselTitle = top().findNode("carouselTitle")
        m.carouselList = top().findNode("carouselList")
        m.titleContainer = top().findNode("titleContainer")
        safeObserve("data", onDataSet)
        safeObserve("focusedChild", onFocusedChildChange)
        safeObserve("itemFocused", onCarouselItemFocused, m.carouselList)
        safeObserve("itemSelected", onCarouselItemSelected, m.carouselList)
        setFocusMap({
            "default": m.carouselList
        })
        styleHooks({
            after: afterStyling
        })
    end sub)
end sub


sub onCarouselItemFocused(options = {})
    if not rodash.isNonEmptyAA(options) then return
    if not rodash.isNode(m.content) then return
    carouselItemFocused = options.data ?? -1
    if carouselItemFocused = -1 then return
    itemModel = m.content.getChild(carouselItemFocused)
    if not rodash.isNode(itemModel) then return
    if m.content.carouselType = carouselTypes.INDEX then dispatch(events.CAROUSEL_ITEM_FOCUSED, { content: itemModel })
    checkPagination({ itemFocused: options.data })
end sub


sub onCarouselItemSelected(options = {})
    if not rodash.isNonEmptyAA(options) then return
    if not rodash.isNode(m.content) then return

    selectedChild = options.data
    itemContent = m.content.getChild(selectedChild)
    if not rodash.isNode(itemContent) then return

    dispatch(events.NAVIGATE_TO, { slug: `/content/${itemContent.id}`, content: itemContent })
end sub


sub onFocusedChildChange(options = {})
    if not rodash.isNonEmptyAA(options) then return
    focusedChild = options.data
    if not rodash.isNode(focusedChild) then return
    if top().isSameNode(focusedChild) then applyDefaultFocus()
end sub


sub onDataSet(options = {})
    if not rodash.isNonEmptyAA(options) then return
    if rodash.isNode(m.content) then return

    data = options.data
    content = data.content

    exec("generateDefaultModels", {}, content)

    if not rodash.isNode(content) then return

    thumbnailType = content.thumbnailType
    configKey = thumbnailType = thumbnailTypes.LANDSCAPE ? "LandscapeCarousel" : "PortraitCarousel"
    liveConfig({ field: "config", keyPath: configKey }, content)

    m.content = content
    m.carouselTitle.text = content.carouselTitle
    m.carouselList.data = { content: content }

    if rodash.isNonEmptyString(thumbnailType) then addClass(lcase(thumbnailType))

    afterStyling()
    dispatch(events.PAGINATE_CAROUSEL, { collection: content })
end sub


sub afterStyling(_options = {})
    stackChildren({ node: m.top, direction: "vertical" })
end sub

sub checkPagination(options = {})
    if not rodash.isNode(m.content) then return
    itemFocused = options.itemFocused ?? 0
    lastPaginatedIndex = m.content.totalCount - 1
    paginationDelta = lastPaginatedIndex - itemFocused

    needsPaginating = paginationDelta <= 5 and m.content.canPaginate and not m.content.paginating
    if needsPaginating then dispatch(events.PAGINATE_CAROUSEL, { collection: m.content })
end sub
