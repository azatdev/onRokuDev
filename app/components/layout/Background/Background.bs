import "pkg:/components/_ord/init.bs"

sub init()
    exec(sub(_options = {})
        m.backgroundContainer = top().findNode("backgroundContainer")
        m.cornerGradient = top().findNode("cornerGradient")
        m.catalogGradientContainer = top().findNode("catalogGradientContainer")
        m.contentGradientContainer = top().findNode("contentGradientContainer")
        m.headerImage = top().findNode("headerImage")

        safeFunctions({
            "hideBackground": hideBackground,
            "hideCatalogGradients": hideCatalogGradients,
            "hideContentGradients": hideContentGradients,
            "setComplimentaryColor": setComplimentaryColor,
            "showBackground": showBackground,
            "showCatalogGradients": showCatalogGradients,
            "showContentGradients": showContentGradients,
            "updateBackgroundAssets": updateBackgroundAssets,
            "updateHeaderImage": updateHeaderImage
        })
    end sub)
end sub


sub hideCatalogGradients(_options = {})
    fadeOut(m.catalogGradientContainer, { duration: 0.5 })
end sub


sub showCatalogGradients(_options = {})
    fadeIn(m.catalogGradientContainer, { duration: 0.5 })
end sub


sub showContentGradients(_options = {})
    fadeIn(m.contentGradientContainer, { duration: 0.5 })
end sub


sub hideContentGradients(_options = {})
    fadeOut(m.contentGradientContainer, { duration: 0.5 })
end sub


sub onBackgroundFadeIn(options = {})
    oldPoster = options.node
    m.backgroundContainer.removeChild(oldPoster)
end sub


sub onBackgroundFadeOut(_options = {})
    for each child in m.backgroundContainer.getChildren(-1, 0)
        child.opacity = 0
    end for
end sub


sub setBackground(newUri = "")
    if rodash.isEmpty(newUri) then return

    newPoster = createObject("roSGNode", "Poster")
    newPoster.id = rodash.now().toStr()
    newPoster.opacity = 0
    newPoster.uri = newUri
    newPoster.width = "<%- s(STYLES.Dimensions.viewport.width) %>"
    newPoster.height = "<%- s(STYLES.Dimensions.viewport.height) %>"
    oldPoster = m.poster
    m.backgroundContainer.appendChild(newPoster)
    fadeIn(newPoster, { callback: onBackgroundFadeIn, callbackOptions: { node: oldPoster }, duration: 0.3 })
    m.poster = newPoster
end sub


sub updateBackgroundAssets(options = {})
    content = options.content
    section = options.section ?? ""

    setComplimentaryColor(options)
    showBackground()

    if section = sections.HERO
        setBackground(content.headerImageUri)
    else if section = sections.CONTENT_HERO
        setBackground(content.posterImageUri)
    end if
end sub


sub updateHeaderImage(options = {})
    m.headerImage.data = options
    showHeaderImage()
end sub


sub setComplimentaryColor(options = {})
    content = options.content
    newBlendColor = content.complimentaryColor

    if rodash.isEmpty(newBlendColor) then newBlendColor = "<%- s(STYLES.Palette.defaultCornerColor) %>"

    morphObject = {}
    morphObject[m.cornerGradient.id] = {
        fields: {
            blendColor: newBlendColor
        }
    }

    morph(morphObject)
end sub


sub hideBackground(_options = {})
    fadeOut(m.backgroundContainer, { callback: onBackgroundFadeOut, duration: 0.3 })
end sub


sub showBackground(_options = {})
    hideHeaderImage()
    fadeIn(m.backgroundContainer, { duration: 0.3 })
end sub


sub hideHeaderImage(_options = {})
    fadeOut(m.headerImage, { callback: clearHeaderImages, duration: 0.3 })
end sub


sub showHeaderImage(_options = {})
    hideBackground()
    fadeIn(m.headerImage, { duration: 0.3 })
end sub


sub clearHeaderImages(_options = {})
    exec("clearImages", {}, m.headerImage)
end sub
