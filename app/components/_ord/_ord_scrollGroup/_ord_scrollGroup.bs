import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub(_options = {})
        m.container = top().findNode("container")
        m.scrolltrack = top().findNode("scrollTrack")
        m.scrollKnob = top().findNode("scrollKnob")
        m.scrollTimer = createObject("roSGNode", "Timer")
        safeObserve("fire", onScrollTimerFired, m.scrollTimer)

        defaultConfig = {
            advanceKey: "down",
            autoFocus: true,
            animationType: "scroll",
            reverseKey: "up",
            direction: "vertical",
            flushEnd: false,
            maxSize: 0,
            scrollBar: {},
            scrollbarPosition: "right",
            scrollSize: 0,
            scrollTimer: 0,
            wrap: false,
            wrapFirstToLast: true
        }

        set({
            defaultConfig: defaultConfig,
            itemFocused: -1
        })

        setFocusMap({
            "onFocus": focusOnScrollGroup,
            "onUnfocus": onCarouselUnfocus,
            "onKey": handleScrollKey
        })

        onConfigChange({ data: defaultConfig })

        safeObserve("animateToItem", onAnimateToItem)
        safeObserve("config", onConfigChange)
        safeObserve("change", onChildChange)
        safeObserve("width", onConfigChange)
        safeObserve("height", onConfigChange)
    end sub)
end sub


sub onAnimateToItem(options = {})
    if not rodash.isNonEmptyAA(options) then return
    nextFocusedItem = options.data ?? 0
    if nextFocusedItem = -1 then return

    itemFocused = get("itemFocused")
    children = m.container.getChildren(-1, 0)
    if not rodash.isNonEmptyArray(children) then return

    performAnimation({
        itemFocused: itemFocused,
        nextFocusedItem: nextFocusedItem,
        children: children
    })
end sub


sub focusOnScrollGroup(_options = {})
    focusIndex = get("itemFocused") ?? 0
    if focusIndex = -1 then focusIndex = get("lastFocused") ?? 0
    focusRow = m.container.getChild(focusIndex)
    setFocus(focusRow, top())

    if get("itemFocused") = -1
        set({ itemFocused: get("lastFocused") ?? 0 })
    end if

    if get("scrollTimer") <> 0 and rodash.isNode(m.scrollTimer)
        m.scrollTimer.control = "start"
    end if
end sub


sub onCarouselUnfocus(_options = {})
    set({
        itemfocused: -1,
        lastFocused: get("itemfocused")
    })
    if not get("autoFocus") then resetFocus()
    if rodash.isNode(m.scrollTimer) then m.scrollTimer.control = "stop"
end sub


sub onConfigChange(options = {})
    if not rodash.isNonEmptyAA(options) then return

    defaultConfig = get("defaultConfig") ?? {}
    config = {}
    config.append(defaultConfig)
    if rodash.isNonEmptyAA(options.data) then config.append(options.data)

    horizontal = config.direction = "horizontal"

    config.horizontal = horizontal
    config.axisIndex= horizontal ? 0 : 1
    config.crossAxisIndex= horizontal ? 1 : 0
    config.targetDimension = horizontal ? "width" : "height"
    config.crossAxisTargetDimension = horizontal ? "height" : "width"

    if config.direction = "vertical"
        config.reverseKey = "up"
        config.advanceKey = "down"
    else
        config.reverseKey = "left"
        config.advanceKey = "right"
    end if

    set(config)
    setGroupSizes()
end sub


sub onChildChange(options = {})
    if not rodash.isNonEmptyAA(options) then return
    changeData = options.data
    if not rodash.isNonEmptyAA(changeData) then return

    animationType = get("animationType") ?? "scroll"
    scrollAnimation = animationType = "scroll"

    currentFocusIndex = get("itemFocused") ?? 0
    currentFocusIndex = currentFocusIndex < 0 ? 0 : currentFocusIndex

    operation = changeData.operation ?? ""
    if operation <> "add" and operation <> "remove" then return

    numberOfNewNodes = changeData.index2 - changeData.index1 + 1
    addedNodes = top().getChildren(numberOfNewNodes, changeData.index1)

    childIndex = 0

    for each child in addedNodes
        if not child.isSubtype("Group") then continue for
        childIndex = m.container.getChildCount()
        updateObject = {
            id: "scrollSlide-" + childIndex.toStr(),
            index: childIndex
        }
        if not scrollAnimation then child.opacity = childIndex = currentFocusIndex ? 1 : 0
        child.update(updateObject, true)
        m.container.appendChild(child)
        childIndex++
    end for

    setGroupSizes()

    if top().isSameNode(top().focusedChild)
        childToFocus = m.container.getChild(currentFocusIndex)
        if rodash.isNode(childToFocus) and not childToFocus.isInFocusChain()
            set({ itemFocused: currentFocusIndex })
            if not scrollAnimation then performFadeMorph([childToFocus])
            if get("autoFocus") then setFocus(childToFocus, top())
        end if
    end if
end sub


sub onScrollTimerFired(_options = {})
    handleScrollKey({ key: get("advanceKey"), autoScroll: true })
end sub


sub setGroupSizes()
    animationType = get("animationType") ?? "scroll"
    scrollAnimation = animationType = "scroll"
    direction = get("direction") ?? "vertical"
    horizontal = get("horizontal") ?? false
    if rodash.isEmptyString(direction) then return

    if scrollAnimation then stackChildren({ node: m.container, direction: direction })

    viewportDimensions = calculate.viewportSize({
        horizontal: horizontal,
        maxSize: get("maxSize")
    })

    scrollContainerDimensions = calculate.scrollContainerSize({
        node: m.container
    })

    set({
        scrollContainerDimensions: scrollContainerDimensions,
        viewportDimensions: viewportDimensions
    })

    setClippingRect()

    scrollbarOptions = get("scrollBar") ?? {}
    showScrollbar = scrollbarOptions.show ?? false

    if get("scrollTimer") <> 0 and rodash.isNode(m.scrollTimer)
        m.scrollTimer.duration = int(get("scrollTimer") / 1000)
    end if

    if not showScrollbar
        m.scrolltrack.visible = false
        return
    end if

    setupScrollbar({
        axisIndex: get("axisIndex"),
        crossAxisIndex: get("crossAxisIndex"),
        crossAxisTargetDimension: get("crossAxisTargetDimension"),
        direction: direction,
        horizontal: horizontal,
        thumbOptions: scrollbarOptions.thumb ?? {},
        trackOptions: scrollbarOptions.track ?? {},
        scrollbarPosition: get("scrollbarPosition"),
        scrollContainerDimensions: scrollContainerDimensions,
        targetDimension: get("targetDimension"),
        viewportDimensions: viewportDimensions
    })
end sub


function handleScrollKey(options = {})
    key = options.key
    if rodash.isEmptyString(key) then return false
    if not get("autoFocus") then return false

    autoScroll = options.autoScroll ?? false

    if not autoScroll and rodash.isNode(m.scrollTimer)
        m.scrollTimer.control = "stop"
    end if

    if rodash.indexOf([get("advanceKey"), get("reverseKey")], key) = -1 then return false

    children = m.container.getChildren(-1, 0)
    if not rodash.isNonEmptyArray(children) then return false

    itemFocused = get("itemFocused")

    nextFocusedItem = calculate.nextIndex({
        itemFocused: itemFocused,
        key: key,
        maxIndex: children.count() - 1
    })

    if nextFocusedItem = itemFocused
        if not get("wrap") then return false
        if get("wrapFirstToLast") and itemFocused = 0 and key = get("reverseKey") then return false
        nextFocusedItem = 0
    end if

    return performAnimation({
        itemFocused: itemFocused,
        nextFocusedItem: nextFocusedItem,
        children: children
    })
end function


function performAnimation(options = {})
    if not rodash.isNonEmptyAA(options) then return false
    itemFocused = options.itemFocused
    nextFocusedItem = options.nextFocusedItem
    children = options.children

    animationType = get("animationType") ?? "scroll"
    scrollAnimation = animationType = "scroll"

    currentFocusNode = children[itemFocused]
    nextFocusNode = children[nextFocusedItem]
    scrollPerformed = false

    if scrollAnimation
        scrollPerformed = performScroll({
            children: children,
            nextFocusedItem: nextFocusedItem,
            nextFocusNode: nextFocusNode
        })
    else
        if not rodash.isNode(currentFocusNode)
            currentFocusNode = searchForVisibleNode()
        end if

        scrollPerformed = performFadeMorph([ nextFocusNode, currentFocusNode])
    end if

    if not scrollPerformed then return false

    if rodash.isNode(nextFocusNode)
        if get("autoFocus") then setFocus(nextFocusNode, top())
        set({ itemFocused: nextFocusedItem })
    end if

    return true
end function


function performScroll(options = {})
    if not rodash.isNonEmptyAA(options) then return false

    axisIndex = get("axisIndex")
    children = options.children ?? []
    direction = get("direction")
    horizontal = direction = "horizontal"
    nextFocusedItem = options.nextFocusedItem ?? 0
    scrollContainerDimensions = get("scrollContainerDimensions")
    viewportDimensions = get("viewportDimensions")

    maxTranslation = [0, 0]

    if get("flushEnd")
        maxTranslation[axisIndex] = scrollContainerDimensions[axisIndex] - viewportDimensions[axisIndex]
    else
        lastChild = rodash.last(children)
        if rodash.isNotInvalid(lastChild)
            lastChildSize = horizontal ? getVisibleWidth(lastChild) : getVisibleHeight(lastChild)
            maxTranslation[axisIndex] = scrollContainerDimensions[axisIndex] - lastChildSize
        end if
    end if

    trackTranslation = m.container.translation
    trackTranslation[axisIndex] = 0

    if nextFocusedItem > 0
        for index = 0 to nextFocusedItem - 1
            child = children[index]
            childSize = horizontal ? getVisibleWidth(child) : getVisibleHeight(child)
            trackTranslation[axisIndex] += childSize
        end for
    end if

    if trackTranslation[axisIndex] > maxTranslation[axisIndex]
        trackTranslation[axisIndex] = maxTranslation[axisIndex]
    end if

    scrollKnobTranslation = m.scrollKnob.translation
    scrollKnobTranslation[axisIndex] = 0

    scrollKnobTranslation[axisIndex] = calculate.scrollTranslation({
        axisIndex: axisIndex,
        targetDimension: get("targetDimension"),
        horizontal: horizontal,
        maxTranslation: maxTranslation,
        scrollKnob: m.scrollKnob,
        trackTranslation: trackTranslation,
        viewportDimensions: viewportDimensions
    })

    trackTranslation[axisIndex] = trackTranslation[axisIndex] * -1

    if m.scrollKnob.translation[axisIndex] <> scrollKnobTranslation[axisIndex]
        performMorph({
            scrollKnobTranslation: scrollKnobTranslation,
            trackTranslation: trackTranslation
        })
        return true
    end if

    return false
end function


function searchForVisibleNode()
    if not rodash.isNode(m.container) then return invalid
    children = m.container.getChildren(-1, 0)
    for each node in children
        if node.opacity > 0 then return node
    end for
    return invalid
end function


sub setClippingRect(_options = {})
    animationType = get("animationType") ?? "scroll"
    scrollAnimation = animationType = "scroll"

    top().clippingRect = [0, 0, top().width, top().height]

    if scrollAnimation
        m.container.clippingRect = [0, 0, m.container.width, m.container.height]
    else
        m.container.clippingRect = [0, 0, top().width, top().height]
    end if
end sub


sub setupScrollbar(options = {})
    if not rodash.isNode(m.scrolltrack) then return
    if not rodash.isNode(m.scrollKnob) then return

    axisIndex = options.axisIndex
    horizontal = options.horizontal
    thumbOptions = options.thumbOptions ?? {}
    trackOptions = options.trackOptions ?? {}
    viewportDimensions = options.viewportDimensions
    scrollbarPosition = options.scrollbarPosition
    scrollContainerDimensions = options.scrollContainerDimensions
    targetDimension = options.targetDimension
    crossAxisTargetDimension = options.crossAxisTargetDimension
    crossAxisIndex = options.crossAxisIndex

    if rodash.isNonEmptyAA(thumbOptions)
        m.scrollKnob.update(thumbOptions, true)
    end if

    if rodash.isNonEmptyAA(trackOptions)
        m.scrolltrack.update(trackOptions, true)
    end if

    stackChildren({ node: m.scrollTrack })

    m.scrolltrack[targetDimension] = viewportDimensions[axisIndex]
    m.scrollKnob[targetDimension] = (viewportDimensions[axisIndex] / scrollContainerDimensions[axisIndex]) * viewportDimensions[axisIndex]

    if horizontal
        if scrollbarPosition <> "top" and scrollbarPosition <> "bottom"
            scrollbarPosition = "bottom"
        end if
    else
        if scrollbarPosition <> "left" and scrollbarPosition <> "right"
            scrollbarPosition = "right"
        end if
    end if

    scrolltrackTranslation = m.scrolltrack.translation
    containerTranslation = m.container.translation

    if scrollbarPosition = "right" or scrollbarPosition = "bottom"
        scrolltrackTranslation[crossAxisIndex] = viewportDimensions[crossAxisIndex] - m.scrolltrack[crossAxisTargetDimension]
        m.container[crossAxisTargetDimension] = viewportDimensions[crossAxisIndex] - m.scrolltrack[crossAxisTargetDimension]
    else if scrollbarPosition = "left" or scrollbarPosition = "top"
        containerTranslation[crossAxisIndex] = m.scrolltrack[crossAxisTargetDimension]
        m.container[crossAxisTargetDimension] = viewportDimensions[crossAxisIndex] - m.scrolltrack[crossAxisTargetDimension]
    end if

    m.scrolltrack.translation = scrolltrackTranslation
    m.container.translation = containerTranslation

    setClippingRect()
    m.scrolltrack.visible = m.scrollKnob[targetDimension] < m.scrolltrack[targetDimension]
end sub


function performFadeMorph(nodeArray = [])
    if not rodash.isNonEmptyArray(nodeArray) then return false
    nodeToFadeIn = nodeArray[0]
    nodeToFadeOut = nodeArray[1]

    if rodash.isNode(nodeToFadeIn) then fadeIn(nodeToFadeIn, { duration: 0.3 })
    if rodash.isNode(nodeToFadeOut) and not nodeToFadeOut.isSameNode(nodeToFadeIn) then fadeOut(nodeToFadeOut, { duration: 0.3 })

    return true
end function


sub performMorph(options = {})
    scrollKnobTranslation = options.scrollKnobTranslation ?? [0, 0]
    trackTranslation = options.trackTranslation ?? [0, 0]

    morphObject = {}

    if rodash.isNode(m.container) and rodash.isNonEmptyString(m.container.id)
        morphObject[m.container.id] = {
            fields: {
                translation: trackTranslation
            }
        }
    end if

    if rodash.isNode(m.scrollKnob) and rodash.isNonEmptyString(m.scrollKnob.id)
        morphObject[m.scrollKnob.id] = {
            fields: {
                translation: scrollKnobTranslation
            }
        }
    end if

    morph(morphObject)
end sub


namespace calculate
    function nextIndex(options = {})
        itemFocused = options.itemFocused
        key = options.key
        maxIndex = options.maxIndex
        nextFocusedItem = itemFocused

        if key = get("advanceKey")
            if itemFocused < maxIndex then nextFocusedItem = itemFocused + 1
        else if key = get("reverseKey")
            if itemFocused > 0 then nextFocusedItem = itemFocused - 1
        end if

        return nextFocusedItem
    end function


    function scrollContainerSize(options = {})
        node = options.node
        if not rodash.isNode(node) then return [1, 1]

        nodeWidth = node.width
        nodeHeight = node.height

        return [
            nodeWidth = 0 ? 1 : nodeWidth,
            nodeHeight = 0 ? 1 : nodeHeight
        ]
    end function


    function scrollTranslation(options = {})
        axisIndex = options.axisIndex
        horizontal = options.horizontal
        maxTranslation = options.maxTranslation
        scrollKnob = options.scrollKnob
        targetDimension = options.targetDimension
        trackTranslation = options.trackTranslation
        viewportDimensions = options.viewportDimensions

        scrollableSize = viewportDimensions[axisIndex] - scrollKnob[targetDimension]
        scrollPercentage = trackTranslation[axisIndex] / maxTranslation[axisIndex]
        scrollTrackTranslation = scrollPercentage * scrollableSize

        if rodash.isInvalid(scrollKnob.margin) then return scrollTrackTranslation

        if scrollPercentage <> 1 and scrollPercentage <> 0 then return scrollTrackTranslation

        margins = quadrupleMargins(scrollKnob.margin)

        if scrollPercentage = 0
            marginOffset = horizontal ? margins.left : margins.top
            scrollTrackTranslation += marginOffset
        else if scrollPercentage = 1
            marginOffset = horizontal ? margins.right : margins.bottom
            scrollTrackTranslation -= marginOffset
        end if

        return scrollTrackTranslation
    end function


    function viewportSize(options = {})
        horizontal = options.horizontal
        maxSize = options.maxSize ?? 0
        viewportHeight = top().height
        viewportWidth = top().width

        if maxSize > 0
            if horizontal
                viewportWidth = maxSize
            else
                viewportHeight = maxSize
            end if
        end if

        return [viewportWidth, viewportHeight]
    end function
end namespace
