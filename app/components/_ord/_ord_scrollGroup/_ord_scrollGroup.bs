import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub()
        m.container = top().findNode("container")
        m.first = top().findNode("first")
        stackChildren({ node: m.container })

        ' morphObject = {}

        ' sharedOptions = {
        '     duration: 3,
        '     callback: animationFinished,
        '     callbackOptions: {
        '         name: "Azat"
        '     }
        ' }

        ' morphObject[m.container.id] = {
        '     fields: {
        '         translation: [0, -100]
        '     }
        ' }

        ' morphObject[m.first.id] = {
        '     delay: 5,
        '     fields: {
        '         color: "#00FF0080",
        '         width: 500
        '     }
        ' }

        ' animationId = morph(morphObject, sharedOptions)


        animationOptions = {
            "duration": 3,
            "easeFunction": "linear",
            "nodeid": m.first.id,
            "optional": true,
            "options": [{
                "field": "width",
                "key": [0, 1],
                "keyvalue": [
                    1650,
                    300
                ]
            }],
            "repeat": true
        }

        animationId = animate(animationOptions)
        ?"animationId " animationId

        rodash.delay(sub(animationId)
            reverse(animationId)
        end sub, 6000, animationId)

        rodash.delay(sub(animationId)
            stopAnimation(animationId)
        end sub, 10000, animationId)
    end sub)
end sub


sub animationFinished(options = {})
    ?"animationFinished " options
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        if not press then return true
        handled = true
        ?"onKeyEvent " key
        ' handled = processFocus(key)
        return handled
    end function, { key: key, press: press })
end function
