import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub()
        m.container = top().findNode("container")
        m.scrolltrack = top().findNode("scrollTrack")
        m.scrollKnob = top().findNode("scrollKnob")

        defaultConfig = {
            direction: "vertical",
            flushEnd: false,
            maxSize: 0,
            showScrollbar: false,
            scrollbarPosition: "right",
            scrollSize: 0
        }

        set({
            defaultConfig: defaultConfig,
            focusedItem: 0
        })

        safeObserve("config", onConfigChange)
        safeObserve("change", onChildChange)
    end sub)
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        if not press then return true
        handled = rodash.indexOf([get("advanceKey"), get("reverseKey")], key) <> -1

        if handled then return performScroll(key)
        return handled
    end function, { key: key, press: press })
end function


sub onConfigChange(options = {})
    if not rodash.isNonEmptyAA(options) then return

    defaultConfig = get("defaultConfig")
    config = {}
    config.append(defaultConfig)
    if rodash.isNonEmptyAA(options.data) then config.append(options.data)

    if config.direction = "vertical"
        config.reverseKey = "up"
        config.advanceKey = "down"
    else
        config.reverseKey = "left"
        config.advanceKey = "right"
    end if

    set(config)
    setGroupSizes()
end sub


sub onChildChange(options = {})
    changeData = options.data

    if rodash.isEmpty(changeData) then return
    operation = changeData.operation ?? ""
    if operation <> "add" and operation <> "remove" then return

    numberOfNewNodes = changeData.index2 - changeData.index1 + 1
    addedNodes = top().getChildren(numberOfNewNodes, changeData.index1)

    for each child in addedNodes
        if child.isSubtype("Group") then m.container.appendChild(child)
    end for

    setGroupSizes()
end sub


sub setGroupSizes()
    direction = get("direction")
    if rodash.isEmptyString(direction) then return

    stackChildren({ node: m.container, direction: direction })

    viewportDimensions = calculate.viewportSize({
        direction: direction,
        maxSize: get("maxSize")
    })

    scrollContainerDimensions = calculate.scrollContainerSize({
        node: m.container
    })

    set({
        scrollContainerDimensions: scrollContainerDimensions,
        viewportDimensions: viewportDimensions
    })

    setClippingRect()

    if not get("showScrollbar") then return

    setupScrollbar({
        direction: direction,
        scrollbarPosition: get("scrollbarPosition"),
        scrollContainerDimensions: scrollContainerDimensions,
        viewportDimensions: viewportDimensions
    })
end sub


function performScroll(key = "")
    if rodash.isEmptyString(key) then return false

    children = m.container.getChildren(-1, 0)
    if not rodash.isNonEmptyArray(children) then return false

    direction = get("direction")
    focusedItem = get("focusedItem")

    nextFocusedItem = calculate.nextIndex({
        focusedItem: focusedItem,
        key: key,
        maxIndex: children.count() - 1
    })

    if nextFocusedItem = focusedItem then return false

    scrollContainerDimensions = get("scrollContainerDimensions")
    viewportDimensions = get("viewportDimensions")

    viewportHeight = viewportDimensions[1]
    contentHeight = scrollContainerDimensions[1]

    maxTranslationY = 0

    if get("flushEnd")
        maxTranslationY = contentHeight - viewportHeight
    else
        lastChild = rodash.last(children)
        if rodash.isNotInvalid(lastChild)
            lastChildHeight = getVisibleHeight(lastChild)
            maxTranslationY = contentHeight - lastChildHeight
        end if
    end if

    translationY = 0
    if nextFocusedItem > 0
        for index = 0 to nextFocusedItem - 1
            child = children[index]
            translationY += getVisibleHeight(child)
        end for
    end if

    if translationY > maxTranslationY
        translationY = maxTranslationY
    end if

    scrollTranslationY = calculate.scrollTranslation({
        direction: direction,
        maxTranslationY: maxTranslationY,
        scrollKnob: m.scrollKnob,
        translationY: translationY,
        viewportHeight: viewportHeight
    })

    performMorph({
        scrollTranslationY: scrollTranslationY,
        translationY: translationY
    })

    children[nextFocusedItem].setFocus(true)

    set({
        focusedItem: nextFocusedItem
    })

    return true
end function


sub setClippingRect(options = {})
    top().clippingRect = [0, 0, top().width, top().height]
    m.container.clippingRect = [0, 0, m.container.width, m.container.height]
end sub


sub setupScrollbar(options = {})
    direction = options.direction
    viewportDimensions = options.viewportDimensions
    scrollbarPosition = options.scrollbarPosition
    scrollContainerDimensions = options.scrollContainerDimensions

    viewportHeight = viewportDimensions[1]
    viewportWidth = viewportDimensions[0]
    totalHeight = scrollContainerDimensions[1]

    stackChildren({ node: m.scrollTrack })

    scrolltrackWidth = m.scrolltrack.width
    m.scrolltrack.height = viewportHeight
    m.scrollKnob.height = (viewportHeight / totalHeight) * viewportHeight

    ?"scrollbarPosition " scrollbarPosition

    if scrollbarPosition = "right"
        m.scrolltrack.translation = [viewportWidth - scrolltrackWidth, 0]
        m.container.width = viewportWidth - scrolltrackWidth
    else if scrollbarPosition = "left"
        ?"scrolltrackWidth " scrolltrackWidth
        m.container.translation = [scrolltrackWidth, 0]
        m.container.width = viewportWidth - scrolltrackWidth
    end if

    ?"m.container.translation " m.container.translation

    setClippingRect()
    m.scrolltrack.visible = true
end sub


sub performMorph(options = {})
    scrollTranslationY = options.scrollTranslationY ?? 0
    translationY = options.translationY ?? 0

    morphObject = {}

    if rodash.isNode(m.container) and rodash.isNonEmptyString(m.container.id)
        morphObject[m.container.id] = {
            fields: {
                translation: [m.container.translation[0], -translationY]
            }
        }
    end if

    if rodash.isNode(m.scrollKnob) and rodash.isNonEmptyString(m.scrollKnob.id)
        morphObject[m.scrollKnob.id] = {
            fields: {
                translation: [m.scrollKnob.translation[0], scrollTranslationY]
            }
        }
    end if

    morph(morphObject)
end sub


namespace calculate
    function nextIndex(options = {})
        focusedItem = options.focusedItem
        key = options.key
        maxIndex = options.maxIndex
        nextFocusedItem = focusedItem

        if key = get("advanceKey")
            if focusedItem < maxIndex then nextFocusedItem = focusedItem + 1
        else if key = get("reverseKey")
            if focusedItem > 0 then nextFocusedItem = focusedItem - 1
        end if

        return nextFocusedItem
    end function


    function scrollContainerSize(options = {})
        node = options.node
        if not rodash.isNode(node) then return [0, 0]
        return [
            node.width,
            node.height
        ]
    end function


    function scrollTranslation(options = {})
        direction = options.direction
        maxTranslationY = options.maxTranslationY
        scrollKnob = options.scrollKnob
        translationY = options.translationY
        viewportHeight = options.viewportHeight

        scrollableSize = viewportHeight - m.scrollKnob.height
        scrollPercentage = translationY / maxTranslationY
        scrollTranslationY = scrollPercentage * scrollableSize

        if rodash.isInvalid(scrollKnob.margin) then return scrollTranslationY

        if scrollPercentage <> 1 and scrollPercentage <> 0 then return scrollTranslationY

        margins = quadrupleMargins(scrollKnob.margin)

        if scrollPercentage = 0
            marginOffset = direction = "horizontal" ? margins.left : margins.top
            scrollTranslationY += marginOffset
        else if scrollPercentage = 1
            marginOffset = direction = "horizontal" ? margins.right : margins.bottom
            scrollTranslationY-= marginOffset
        end if

        return scrollTranslationY
    end function


    function viewportSize(options = {})
        direction = options.direction
        maxSize = options.maxSize
        viewportHeight = top().height
        viewportWidth = top().width

        if maxSize > 0
            if direction = "horizontal"
                viewportHeight = maxSize
            else
                viewportWidth = maxSize
            end if
        end if

        return [viewportWidth, viewportHeight]
    end function

end namespace
