import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub()
        m.container = top().findNode("container")
        m.first = top().findNode("first")
        stackChildren({ node: m.container })

        morphObject = {}

        sharedOptions = {
            duration: 3,
            callback: animationFinished,
            callbackOptions: {
                name: "Azat"
            }
        }

        morphObject[m.container.id] = {
            fields: {
                translation: [0, -100]
            }
        }

        morphObject[m.first.id] = {
            delay: 5,
            fields: {
                color: "#00FF0080",
                width: 500
            }
        }

        animationId = morph(morphObject, sharedOptions)
        ?"animationId " animationId

        ' rodash.delay(sub(morphObject)
        '     morph(morphObject)
        ' end sub, 5000, morphObject)
    end sub)
end sub


sub animationFinished(options = {})
    ?"animationFinished " options
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        if not press then return true
        handled = true
        ?"onKeyEvent " key
        ' handled = processFocus(key)
        return handled
    end function, { key: key, press: press })
end function
