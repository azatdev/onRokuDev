import "pkg:/components/_ord/init.bs"

sub init()
    exec(sub(_options = {})
        setTaskFunction(runQueue)
    end sub)
end sub


function runQueue(_options = {})
    messagePort = createObject("roMessagePort")
    safeObserve("eventData", messagePort)
    top().ready = true

    while true
        msg = wait(0, messagePort)
        if msg = invalid then continue while

        messageData = msg.getData()
        if rodash.isEmpty(messageData) then continue while

        eventId = messageData.id ?? ""
        eventOptions = messageData.options ?? {}

        if rodash.isEmpty(eventId) then continue while
        publish(eventId, eventOptions)
    end while

    return true
end function
