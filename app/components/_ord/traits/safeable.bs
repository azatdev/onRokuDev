class Safeable
    publicFunctions = []

    sub new(options = {})
        top().addField("_ord_safeFunctions", "assocarray", false)
        top().addField("_ord_proxyData", "assocarray", true)
        top().addField("_ord_callbacks", "assocarray", false)
        top().setRef("_ord_safeFunctions", {})
        top().setRef("_ord_proxyData", {})

        m.setExportFunctions(role())
    end sub


    sub setExportFunctions(componentRole = "")
        if rodash.isEmptyString(componentRole) then return

        m.publicFunctions.push("exec")
        m.publicFunctions.push("safeObserve")
        m.publicFunctions.push("safeUnobserve")
        m.publicFunctions.push("safeFunctions")

        if rodash.findIndex(["Task"], componentRole) <> -1
            m.publicFunctions.push("setTaskFunction")
        end if

        if rodash.findIndex(["Scene", "View", "Model"], componentRole) = -1 then return

        m.publicFunctions.push("safeFunc")

        if top().hasFunc("safeFunc") then return

        ?`

        WARNING: Please add
        <function name="safeFunc" />
        to ${top().subType()}.xml file

        `
    end sub


    function exec(options = {})
        if not rodash.isNonEmptyAA(options) then return invalid

        if devMode()
            return m.runFunc(options)
        else
            try
                return m.runFunc(options)
            catch e
                return onError(e)
            end try
        end if
    end function


    function runFunc(options = {})
        func = options.func
        functionArgument = options.options ?? {}
        node = options.node ?? top()

        if not node.isSameNode(top())
            return m.proxyFunc(func, functionArgument, node)
        end if

        targetFunction = invalid

        if rodash.isFunction(func)
            targetFunction = func
        end if

        if rodash.isString(func)
            nodeSafeFunctions = top().getRef("_ord_safeFunctions")
            nodeFunction = nodeSafeFunctions[func]
            targetFunction = nodeFunction
        end if


        if rodash.isFunction(targetFunction)
            return targetFunction(functionArgument)
        '     try
        '         return targetFunction(functionArgument)
        '     catch e
        '         if e.number = 241
        '             return targetFunction()
        '         end if

        '         if devMode() then throw e

        '         return invalid
        '     end try
        end if

        internalFunctions = getGlobalAA().interfaceFunctions ?? {}

        internalInterface = internalFunctions[func] ?? {}

        if rodash.isNonEmptyAA(internalInterface) then return internalInterface[func](functionArgument)

        return invalid
    end function


    function proxyFunc(functionName = "", options = {}, node = {})
        if not rodash.isNode(node) then return invalid

        proxyData = node.getRef("_ord_proxyData") ?? {}

        if not rodash.isEmpty(options)
            proxyData.input = options
        end if

        node.callFunc("safeFunc", functionName)

        returnObj = proxyData.output ?? invalid
        proxyData.output = invalid
        return returnObj
    end function


    sub processSafeFunc(functionName)
        proxyData = top().getRef("_ord_proxyData") ?? {}
        options = proxyData.input
        returnData = exec(functionName, options, top())
        proxyData.input = invalid
        proxyData.output = returnData
    end sub


    sub safeObserve(fieldName = "", callbackFunc = "", node = getGlobalAA().top, infoFields = [])
        if rodash.isEmptyString(fieldName) then return

        if role() = "Task" and rodash.isMessagePort(callbackFunc)
            node.observeFieldScopedEx(fieldName, callbackFunc, infoFields)
            return
        end if

        if rodash.isEmptyString(callbackFunc) then return

        nodeIdentifier = node.isSameNode(getGlobalAA().top) ? "" : `_${node.subType()}_${node.id}`
        uniqueFieldName = `${fieldName}${nodeIdentifier}`

        m.storeCallback({
            field: uniqueFieldName,
            callback: callbackFunc
        })

        node.unObserveFieldScoped(fieldName)
        node.observeFieldScoped(fieldName, rodash.getFunctionName(m.safeCallback), infoFields)
    end sub


    sub safeUnobserve(fieldName = "", node = getGlobalAA().top)
        if rodash.isEmptyString(fieldName) then return
        nodeIdentifier = node.isSameNode(getGlobalAA().top) ? "" : `_${node.subType()}_${node.id}`
        uniqueFieldName = `${fieldName}${nodeIdentifier}`
        node.unObserveFieldScoped(fieldName)
        m.removeCallback({ field: uniqueFieldName })
    end sub


    sub safeCallback(event)
        fieldName = event.getField() ?? ""
        if rodash.isEmptyString(fieldName) then return

        callbacks = top().getRef("_ord_callbacks") ?? {}
        node = event.getRoSGNode()
        nodeIdentifier = node.isSameNode(getGlobalAA().top) ? "" : `_${node.subType()}_${node.id}`
        uniqueFieldName = `${fieldName}${nodeIdentifier}`

        functionName = callbacks[uniqueFieldName] ?? ""
        if rodash.isEmptyString(functionName) then return

        payload = {
            data: event.getData(),
            field: event.getField(),
            info: event.getInfo(),
            node: event.getRoSGNode(),
            nodeId: event.getNode()
        }

        exec(functionName, payload)
    end sub


    function safeFunc(functionName = "")
        if devMode()
            return m.processSafeFunc(functionName)
        else
            try
                return m.processSafeFunc(functionName)
            catch e
                return onError(e)
            end try
        end if
    end function


    sub safeFunctions(options = {})
        if not rodash.isAA(options) then return
        allFunctions = top().getRef("_ord_safeFunctions") ?? {}
        allFunctions.append(options)
    end sub


    sub removeCallback(options = {})
        callbacks = top().getRef("_ord_callbacks") ?? {}

        field = options.field
        callbacks.delete(field)
        top().setRef("_ord_callbacks", callbacks)
    end sub


    sub storeCallback(options = {})
        callbacks = top().getRef("_ord_callbacks") ?? {}

        field = options.field
        callback = options.callback

        callbacks[field] = callback
        top().setRef("_ord_callbacks", callbacks)
    end sub


    sub setTaskFunction(options = {})
        if not rodash.isNonEmptyAA(options) then return
        taskFunction = options.function
        getGlobalAA()._ord_taskFunction = taskFunction
    end sub

end class
