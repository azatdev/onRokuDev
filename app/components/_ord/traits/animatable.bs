class Animatable
    animations = {}
    publicFunctions = []
    defaultOptions = {
        "duration": 0.3,
        "easeFunction": "linear",
        "repeat": false,
        "optional": true,
        "options": []
    }

    sub new(options = {})
        m.setExportFunctions(role())
        if rodash.findIndex(["Scene", "View"], role()) = -1 then return
    end sub


    sub setExportFunctions(componentRole = "")
        if rodash.isEmptyString(componentRole) then return

        if rodash.findIndex(["Scene", "View"], componentRole) = -1 then return

        m.publicFunctions.push("animate")
        m.publicFunctions.push("reverse")
        m.publicFunctions.push("morph")
        m.publicFunctions.push("finishAnimation")
        m.publicFunctions.push("stopAnimation")
        m.publicFunctions.push("removeAnimation")
        m.publicFunctions.push("fadeIn")
        m.publicFunctions.push("fadeOut")
    end sub


    function animate(animation, options = {})
        animationId = m.prepareAnimation(animation, options)
        m.runAnimation(animationId)
        return animationId
    end function


    function reverse(animation, options = {})
        animationId = m.prepareAnimation(animation, options)
        m.runAnimation(animationId, true)
        return animationId
    end function


    function prepareAnimation(animation = "", options = {})
        if rodash.isString(animation)
            animationId = animation
        else
            if not rodash.isAA(animation) and not rodash.isArray(animation) then return invalid
            animationOptionsArray = rodash.isAA(animation) ? [animation] : animation
            animationId = m.constructAnimationId(animationOptionsArray)
            m.addAnimation(animationId, animationOptionsArray)
        end if

        if rodash.isNonEmptyAA(options)
            animationCallback = options.callback
            animationCallbackOptions = options.callbackOptions ?? {}

            animation = m.animations[animationId] ?? invalid
            if not rodash.isNode(animation) then return invalid

            if rodash.isNotInvalid(animationCallback) then m.setAnimationCallback({
                animation: animation,
                callback: animationCallback,
                options: animationCallbackOptions
            })
        end if

        return animationId
    end function


    sub runAnimation(id = "", isReverse = false)
        if rodash.isEmptyString(id) then return

        animation = m.animations[id] ?? invalid
        if not rodash.isNode(animation) then return

        m.setReverse(animation.getChildren(-1, 0), isReverse)

        safeObserve("state", m.onAnimationComplete, animation)
        animation.control = "start"

        if rodash.isAA(m.continuousAnimations) and not m.continuousAnimations.doesExist(id)
            m.activeAnimations({ action: "add", id: id, node: animation })
        end if
    end sub


    sub finishAnimation(id = "")
        if rodash.isEmptyString(id) then return

        animation = m.animations[id] ?? invalid
        if not rodash.isNode(animation) then return
        animation.control = "finish"
        safeUnobserve("state", animation)
    end sub


    sub stopAnimation(id = "")
        if rodash.isEmptyString(id) then return

        animation = m.animations[id] ?? invalid
        if not rodash.isNode(animation) then return
        animation.control = "stop"
        safeUnobserve("state", animation)
    end sub


    function createAnimation(animationId = "", options = {})
        if rodash.isEmptyString(animationId) then return invalid
        if not rodash.isNonEmptyAA(options) then return invalid

        settings = {}
        settings.append(options)
        nodeId = settings.nodeId ?? ""
        animationOptions = settings.options ?? []
        settings.delete("options")

        animation = top().findNode(animationId)
        if rodash.isInvalid(animation) then animation = createObject("roSGNode", "Animation")

        animation.id = animationId
        animation.setFields(settings)

        for each option in animationOptions
            field = option.field ?? ""
            if rodash.isEmptyString(field) then continue for

            keyValue = option.keyValue ?? invalid
            if not rodash.isNonEmptyArray(keyValue) then continue for

            interpId = [nodeId, field].join(".")
            interpField = animation.findNode(interpId)

            if not rodash.isNode(interpField)
                interp = m.getInterpName(field)
                if rodash.isEmptyString(interp) then continue for
                interpField = createObject("roSGNode", interp)
                interpField.fieldToInterp = interpId
                interpField.id = interpId
            end if

            interpField.key = option.key ?? [0, 1]
            interpField.keyValue = keyValue
            animation.appendChild(interpField)
        end for

        return animation
    end function


    sub addAnimation(id = "", animations = [])
        if rodash.isEmptyString(id) then return
        if not rodash.isArray(animations) then return
        if m.animations = invalid then m.animations = {}

        animationCollection = []

        for each settings in animations
            animation = m.createAnimation(id, settings)
            if rodash.isNode(animation) then animationCollection.push(animation)
        end for

        if animationCollection.count() = 0 then return

        if animationCollection.count() > 1
            animationShell = top().findNode(id)

            if not rodash.isNode(animationShell)
                animationShell = createObject("roSGNode", "ParallelAnimation")
                top().appendChild(animationShell)
            end if

            duration = 0

            for each item in animationCollection
                if item.duration > duration then duration = item.duration
                animationShell.appendChild(item)
            end for

            animationShell.update({ duration: duration }, true)
        else
            animationShell = animationCollection[0]
        end if

        animationShell.id = id

        if not rodash.isNode(animationShell) then return

        m.animations[id] = animationShell
    end sub


    sub removeAnimation(id = "")
        if rodash.isEmptyString(id) then return

        animationShell = m.animations[id] ?? invalid
        if not rodash.isNode(animationShell) then return

        safeUnobserve("state", animationShell)
        if animationShell.hasField("callback") then animationShell.setRef("callback", {})
        m.animations.delete(id)
    end sub


    function getInterpName(field = "") as Object
        if rodash.isEmptyString(field) then return ""

        fieldsMap = {
            "blendColor": "ColorFieldInterpolator",
            "color": "ColorFieldInterpolator",
            "height": "FloatFieldInterpolator",
            "opacity": "FloatFieldInterpolator",
            "scale": "Vector2DFieldInterpolator",
            "size": "FloatFieldInterpolator",
            "translation": "Vector2DFieldInterpolator",
            "width": "FloatFieldInterpolator"
        }

        if fieldsMap.doesExist(field) then return fieldsMap[field]
        return ""
    end function


    sub setReverse(animationChildren, isReverse = false as Boolean)
        for each child in animationChildren
            if child.subType() = "Animation" or child.subType() = "ParallelAnimation"
                m.setReverse(child.getChildren(-1, 0), isReverse)
            else if rodash.indexOf(["Vector2DFieldInterpolator", "FloatFieldInterpolator", "ColorFieldInterpolator"], child.subType()) <> -1
                child.reverse = isReverse
            end if
        end for
    end sub


    sub onAnimationComplete(options = {})
        state = options.data ?? ""
        animation = options.node

        if state <> "stopped" then return
        if not rodash.isNode(animation) then return

        safeUnobserve("state", animation)

        if rodash.isAA(m.continuousAnimations) and m.continuousAnimations.doesExist(animation.id)
            m.activeAnimations({ action: "delete", id: animation.id })
        end if

        callback = animation.hasField("callback") ? animation.getRef("callback") : invalid
        callbackFunction = callback.function
        callbackOptions = callback.options

        if not rodash.isNonEmptyAA(callback) then return

        if animation.hasField("callback") then animation.setRef("callback", {})

        if rodash.isInvalid(callbackFunction) then return

        if rodash.isFunction(callbackFunction) or rodash.isNonEmptyString(callbackFunction)
            exec(callbackFunction, callbackOptions)
        end if
    end sub


    function returnAnimationOptions(options = {})
        nodeId = options.nodeId
        if rodash.isEmptyString(nodeId) then return invalid

        nodeFields = options.fields ?? {}
        if not rodash.isNonEmptyAA(nodeFields) then return invalid
        options.delete("fields")

        node = top().findNode(nodeId)
        if not rodash.isNode(node) then return invalid

        fieldOptionsArray = []

        for each field in nodeFields.items()
            fieldName = field.key
            oldValue = node[fieldName]
            newValue = field.value
            if rodash.isNumber(oldValue)
                oldValue = m.toFloatValue(oldValue)
            end if

            if rodash.isNumber(newValue)
                newValue = m.toFloatValue(newValue)
            end if

            if fieldName = "color" or fieldName = "blendColor"
                newValueClean = newValue.toStr().replace("#", "")
                newValue = val(newValueClean, 16)
                oldColorValue% = node[fieldName]
                oldValue = oldColorValue%
            end if

            if type(oldValue) <> type(newValue) and rodash.isEqual(oldValue, newValue) then return invalid

            animationOptionsObj = {
                field: fieldName,
                keyValue: [oldValue, newValue]
            }

            fieldOptionsArray.push(animationOptionsObj)
        end for

        options.options = fieldOptionsArray

        return options
    end function


    function morph(morphObject = {}, sharedOptions = {})
        if not rodash.isNonEmptyAA(morphObject) then return invalid
        if m.animations = invalid then m.animations = {}

        animationOptionsArray = []
        animationCallback = invalid
        animationCallbackOptions = {}

        if rodash.isNotInvalid(sharedOptions.callback)
            animationCallback = sharedOptions.callback
            sharedOptions.delete("callback")
        end if

        if rodash.isNotInvalid(sharedOptions.callbackOptions)
            animationCallbackOptions = sharedOptions.callbackOptions
            sharedOptions.delete("callbackOptions")
        end if

        for each item in morphObject.items()
            nodeId = item.key
            options = item.value
            options.nodeId = nodeId
            options.append(m.defaultOptions)

            animationOptions = m.returnAnimationOptions(options)
            if not rodash.isNonEmptyAA(animationOptions) then continue for

            if rodash.isNonEmptyAA(sharedOptions) then animationOptions.append(sharedOptions)

            animationOptionsArray.push(animationOptions)
        end for

        animationId = m.constructAnimationId(animationOptionsArray)
        ' animation = m.animations[animationId] ?? invalid
        m.addAnimation(animationId, animationOptionsArray)

        animation = m.animations[animationId] ?? invalid
        if not rodash.isNode(animation) then return invalid

        if rodash.isNotInvalid(animationCallback) then m.setAnimationCallback({
            animation: animation,
            callback: animationCallback,
            options: animationCallbackOptions
        })

        m.runAnimation(animationId)

        return animationId
    end function


    function constructAnimationId(options = []) as String
        if not rodash.isNonEmptyArray(options) then return ""

        animationId = top().createdAt.toStr() ?? ""

        for each nodeOptions in options
            nodeId = nodeOptions.nodeId ?? ""
            animationId += nodeId

            fields = nodeOptions.options ?? []
            for each fieldObject in fields
                animationId += fieldObject.field ?? ""
            end for
        end for

        return animationId
    end function


    sub setAnimationCallback(options = {})
        animation = options.animation
        callback = options.callback
        options = options.options

        if rodash.isInvalid(animation.callback) then animation.addField("callback", "assocarray", false)

        animation.setRef("callback", {
            function: callback,
            options: options
        })
    end sub


    function fadeIn(node = invalid, options = {})
        if not rodash.isNode(node) then return invalid
        return m.fade(node, { opacity: 1 }, options)
    end function


    function fadeOut(node = invalid, options = {})
        if not rodash.isNode(node) then return invalid
        return m.fade(node, { opacity: 0 }, options)
    end function


    function fade(node = invalid, options = {}, sharedOptions = {})
        if not rodash.isNode(node) then return invalid

        nodeId = node.id ?? ""
        if rodash.isEmptyString(nodeId) then return invalid

        morphObject = {}

        morphObject[nodeId] = {
            fields: options
        }

        return m.morph(morphObject, sharedOptions)
    end function


    function activeAnimations(options = {}) as Object
        if not rodash.isAA(options) then return invalid

        scene = app()
        if not rodash.isNode(scene) then return invalid
        if not scene.hasFunc("manageActiveAnimations") then return invalid

        payload = options
        payload.nodeId = m.getNodeId()
        return scene.callFunc("manageActiveAnimations", payload)
    end function


    function getNodeId() as String
        return `${top().subType()}_${top().createdAt.toStr() ?? ""}`
    end function


    function toFloatValue(value)
        if not rodash.isNumber(value) then return value
        floatValue! = value
        return floatValue!
    end function
end class
