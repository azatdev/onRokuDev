class Focusable
    focusReady = false
    focusMap = {}
    focusNode = invalid
    focusFunction = invalid
    publicFunctions = []
    lastFocus = rodash.now()
    focusInterval = 500

    sub new(_options = {})
        m.setExportFunctions(getGlobalAA().ord_role)
    end sub


    sub setExportFunctions(componentRole = "")
        if rodash.isEmptyString(componentRole) then return

        if rodash.findIndex(["Scene", "View"], componentRole) = -1 then return

        m.publicFunctions.push("applyDefaultFocus")
        m.publicFunctions.push("onFocusedChildChange")
        m.publicFunctions.push("setFocus")
        m.publicFunctions.push("onKeyEvent")
        m.publicFunctions.push("resetFocus")
        m.publicFunctions.push("setFocusMap")
    end sub


    sub applyDefaultFocus()
        if rodash.isNode(m.focusMap.current) and not top().isSameNode(m.focusMap.current)
            defaultNode = m.focusMap.current
        else if top().isSameNode(m.focusMap.current)
            defaultNode = m.focusMap.onFocus
        else
            defaultNode = m.focusMap.onFocus ?? m.focusMap.current
        end if

        if rodash.isFunction(defaultNode)
            exec(defaultNode)
            return
        end if

        if not rodash.isNode(defaultNode) and rodash.isString(defaultNode) then defaultNode = top().findNode(defaultNode)
        ' if not rodash.isNode(defaultNode) then defaultNode = top().getChild(0)
        ' if not rodash.isNode(defaultNode) then defaultNode = top()
        m.setFocus({ nodeToFocus: defaultNode })
    end sub


    function exceedsFocusInterval()
        if global().lastFocusedTime = invalid
            global().addField("lastFocusedTime", "longinteger", false)
        end if

        lastFocusedTime = global().lastFocusedTime
        currentTime = rodash.now()
        return currentTime - lastFocusedTime < m.focusInterval
    end function


    function getFocusedChild(node = {})
        if not rodash.isNode(node) then node = top()

        focusedNode = node.focusedChild
        if rodash.isNode(focusedNode.focusedChild) and not focusedNode.focusedChild.isSameNode(focusedNode)
            return m.getFocusedChild(focusedNode.focusedChild)
        else
            return rodash.isNode(focusedNode) ? focusedNode : node
        end if
    end function


    sub onFocusedChildChange(options = {})
        if not rodash.isNonEmptyAA(options) then return
        focusedChild = options.data
        if not rodash.isNode(focusedChild) then m.onFocusRemoved(): return
        if top().isSameNode(focusedChild) then m.applyDefaultFocus()
    end sub


    sub onFocusRemoved()
        unfocusFunction = m.focusMap.onUnfocus
        if rodash.isFunction(unfocusFunction) then exec(unfocusFunction)
    end sub


    function onKeyEvent(options = {}) as boolean
        if not rodash.isNonEmptyAA(options) then return false
        if not options.press then return true
        handled = m.processFocus(options.key)
        if devMode() then ?top().subType(), options.key, handled
        return handled
    end function


    function processFocusFunction(options = {})
        if not rodash.isNonEmptyAA(options) then return false

        focusFunction = options.focusFunction
        if not rodash.isFunction(focusFunction) then return false

        functionHandled = exec(focusFunction, { key: options.key })
        ' Supporting subs
        if functionHandled = invalid then return true
        if rodash.isBoolean(functionHandled) then return functionHandled
        return true
    end function


    function processFocus(key as string)
        if m.exceedsFocusInterval() then return true
        handled = false
        if not rodash.isNonEmptyAA(m.focusMap) then return handled

        focusTarget = m.focusMap.current ?? {}
        nodeMap = m.focusMap[focusTarget.id ?? ""] ?? m.focusMap.onKey

        if rodash.isInvalid(nodeMap) then return handled

        if rodash.isFunction(nodeMap)
            focusArray = nodeMap
        else
            focusArray = nodeMap[key] ?? nodeMap["default"]
        end if

        if rodash.isInvalid(focusArray) then return handled

        if not rodash.isArray(focusArray) then focusArray = [focusArray]

        for each target in focusArray
            if rodash.isFunction(target)
                functionHandled = m.processFocusFunction({ focusFunction: target, key: key })
                if not handled then handled = functionHandled
                continue for
            end if

            if rodash.isInvalid(target) then continue for

            if rodash.isBoolean(target)
                handled = target
                continue for
            end if

            if not rodash.isNode(target) and rodash.isNonEmptyString(target)
                target = top().findNode(target)
            end if

            if not rodash.isNode(target) then continue for

            m.setFocus({ nodeToFocus: target })
            if not handled then handled = true
        end for

        if handled then global().lastFocusedTime = rodash.now()
        return handled
    end function


    sub resetFocus(_options = {})
        m.focusMap.current = invalid
    end sub


    sub setFocus(options = {})
        if not rodash.isNonEmptyAA(options) then return
        nodeToFocus = options.nodeToFocus
        focusMapNode = options.focusMapNode

        m.focusMap.current = rodash.isNode(focusMapNode) ? focusMapNode : nodeToFocus
        if rodash.isNode(nodeToFocus) then nodeToFocus.setFocus(true)
    end sub


    sub setFocusMap(options = {})
        if not rodash.isNonEmptyAA(options) then return
        m.focusMap.append(options)
        'bs:disable-next-line
        if rodash.isFunction(onFocusedChildChange) then return
        safeObserve("focusedChild", "onFocusedChildChange", top())
    end sub
end class
