import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub()
        m.carousel = top().findNode("carousel")
        m.carousel.showTargetRects = true

        defaultConfig = {
            animationDuration: 0.3,
            carouselDimensions: [0, 0],
            clip: true,
            componentName: "",
            defaultVisibleIndex: 0,
            ' lastIndex: 2,
            direction: "horizontal",
            dynamicRectSizes: [],
            focusType: "floating",
            flushFocus: false,
            gutterWidth: 0,
            visibleTiles: 0,
            wrap: false,
            bigSquare: [0, 0],
            smallSquare: [0, 0],
            squareMargins: [0, 0],
            squareTotalArea: [0, 0]
            ' type: "FloatingFocus",
            ' type: "FixedFocus",
            ' type: "DynamicSize",

            ' animation: {
            '     duration: 0.3
            ' },
            ' carousel: {
            '     clip: true,
            '     defaultVisibleIndex: 0,
            '     direction: "horizontal",
            '     focusType: "floating",
            '     wrap: false,
            '     gutterSize: 0,
            '     visibleTiles: 0,
            '     totalArea: []
            ' },
            ' square: {
            '     big: [],
            '     small: [],
            '     margins: [],
            '     totalArea: []
            ' }
        }

        set({ defaultConfig: defaultConfig })
        set(defaultConfig)

        safeObserve("data", onDataSet)
        safeObserve("focusedChild", onFocusedChildChange)

        m.focusTimer = top().findNode("focusTimer")
        m.focusTimer.update({
            finishTime: rodash.now(),
            focused: false,
            startTime: rodash.now()
        }, true)

        m.focusTimer.duration = 0.016
        m.focusTimer.repeat = true
        safeObserve("fire", onFocusTimerFired)
    end sub)
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        key = options.key
        press = options.press
        carousel = options.carousel
        ?"inside onKeyEvent " key, press, carousel
        if not press then return true

        if CommonUtils_floatMOD(carousel.currFocusItemIndex, 1) <> 0 then return true
        if key <> top().advanceKey and key <> top().reverseKey then return false

        direction = key = top().reverseKey ? -1 : 1

        currentIndex = top().focusedContentIndex
        nextIndex = currentIndex + direction

        currentTargetSetIndex = top().focusedTargetsetIndex
        nextTargetSetIndex = currentTargetSetIndex + direction
        if nextTargetSetIndex <= 0 then nextTargetSetIndex = 0
        if nextTargetSetIndex >= m.lastVisibleIndex then nextTargetSetIndex = m.lastVisibleIndex

        if carousel.content.getChild(nextIndex) = invalid
            if not get("wrap") then return false

            if direction = 1
                nextIndex = 0
                nextTargetSetIndex = 0
            else
                profilesCollection = carousel.content
                if not rodash.isNode(profilesCollection) then return true
                nextIndex = profilesCollection.getChildCount() - 1
                nextTargetSetIndex = nextIndex
            end if
        end if

        if not rodash.isArray(m.targetSetArray) then return false

        nextTargetSet = m.targetSetArray[nextTargetSetIndex]

        if nextTargetSet <> invalid and carousel.currTargetSet <> invalid and nextTargetSet.focusIndex <> carousel.currTargetSet.focusIndex
            carousel.animateToTargetSet = nextTargetSet
            top().focusedTargetsetIndex = nextTargetSetIndex
        end if

        carousel.animateToItem = nextIndex
        top().focusedContentIndex = nextIndex

        return true
    end function, { key: key, press: press, carousel: m.carousel })
end function


sub onFocusTimerFired(options = {})
    finishTime = m.focusTimer.finishTime
    startTime = m.focusTimer.startTime
    currentTime = rodash.now()

    totalDuration! = finishTime - startTime
    if totalDuration! <= 0
        m.focusTimer.control = "stop"
        currentPercentage = m.focusTimer.focused ? 1 : 0
        m.list.focusPercent = currentPercentage
        return
    end if

    elapsedTime! = currentTime - startTime
    currentPercentage = elapsedTime! / totalDuration!

    if currentTime > finishTime
        m.focusTimer.control = "stop"
        currentPercentage = 1
    else if currentPercentage < 0
        currentPercentage = 0
    else if currentPercentage > 1
        currentPercentage = 1
    end if

    if not m.focusTimer.focused then currentPercentage = 1 - currentPercentage

    m.list.focusPercent = currentPercentage
end sub


sub onFocusedChildChange(options = {})
    node = options.data
    currentIndex = top().focusedContentIndex
    if m.content = invalid then return

    unfocused = node = invalid or not node.isSameNode(m.top) and not top().isInFocusChain()

    if not rodash.isNode(m.carousel.targetSet) then return

    m.focusTimer.focused = not unfocused

    currentTime = rodash.now()
    durationMs = m.carousel.duration * 1000
    finishTime = currentTime + durationMs
    m.focusTimer.startTime = currentTime
    m.focusTimer.finishTime = finishTime
    if m.focusTimer.control <> "start"
        m.focusTimer.control = "start"
    end if

    if unfocused
        unFocusedTargetSet = m.unFocusedTargetSet
        unFocusedTargetSet.focusIndex = m.carousel.targetSet.focusIndex
        m.carousel.animateToTargetSet = unFocusedTargetSet
        m.carousel.animateToItem = currentIndex
        return
    end if

    if not rodash.isArray(m.targetSetArray) then return

    currentTargetSet = m.targetSetArray[top().focusedTargetsetIndex]

    m.carousel.animateToItem = currentIndex
    m.carousel.animateToTargetSet = currentTargetSet
    m.carousel.easeFunction = "linear"
end sub


sub onDataSet(options = {})
    if not rodash.isNonEmptyAA(options) then return

    data = options.data ?? {}
    content = data.content
    if not rodash.isNode(content) then return

    safeObserve("totalCount", onTotalCountChange, content)
    safeObserve("rectConfig", processConfig, content)

    m.content = content

    set({ totalCarouselItems: content.totalCount ?? 0 })
    processConfig({ data: content.rectConfig })
end sub


sub onTotalCountChange(options = {})
    if not rodash.isNonEmptyAA(options) then return
    totalCarouselItems = options.data
    if rodash.isNumber(totalCarouselItems) then set({ totalCarouselItems: totalCarouselItems })
    processConfig()
end sub


sub processConfig(options = {})
    ' if not rodash.isNonEmptyAA(options) then return

    config = options.data ?? {}
    if rodash.isAA(config) then set(config)

    set({
        carouselDimensions: calculate.carouselDimensions(),
        totalRects: calculate.totalRects(),
        maxVisibleTiles: calculate.visibleTiles(),
        squareTotalArea: calculate.squareTotalArea()
    })

    processRects()
end sub


' Entry to generating TargetGroup rects
sub processRects()
    ?"processRects " get("totalCarouselItems")
    if get("totalCarouselItems") = 0 then return

    ' m.processedForRects = m.totalRects

    ' totalRects = flushFocus ? get("totalCarouselItems") : tilesOnScreen + (extraRects * 2)

    ' if TypeGuard_isTruthy(flushFocus)
    '     generateDynamicRects()
    ' else
    '     generateRects()
    ' end if

    generateRects()
    setListContent()

    top().width = getWidth()
    top().height = getHeight()

    if get("direction") = "vertical"
        top().reverseKey = "up"
        top().advanceKey = "down"
    else
        top().reverseKey = "left"
        top().advanceKey = "right"
    end if

    ' setAutoclip()
end sub


sub setAutoclip()
    if get("clip")
        top().clippingRect = [0, 0, m.top.width, m.top.height]
        m.carousel.clippingRect = [0, 0, m.top.width, m.top.height]
    end if
end sub


sub setListContent()
    ' content = top().content
    ' if not TypeGuard_isNode(content)
    '     m.list.content = invalid
    '     m.childCount = 0
    '     return
    ' end if

    ' if not TypeGuard_isSameNode(m.list.content, content)
    '     m.list.content = content
    ' end if

    ?" m.content 2 "  m.content
    m.carousel.content = m.content
    m.carousel.itemComponentName = get("itemComponentName")
    m.carousel.duration = get("animationDuration") ?? 0.3
end sub


sub generateRects(options = {})
    ?"generateRects " options

    ' defaultVisibleIndex = options.defaultVisibleIndex ?? 0
    ' maxVisibleTiles = options.visibleTiles ?? 0
    ' visibleDimensions = getCarouselDimensions()

    targetsetRects = returnTargetsetRects()
    unfocusedRects = targetsetRects.shift()
    setUnfocusedTargetSet(unfocusedRects)

    ' Calculate the first and last visible rects
    ' accounting for extra gutter rects
    visibleIndexArray = getVisibleIndices()
    m.firstVisibleIndex = visibleIndexArray[0]
    m.lastVisibleIndex = visibleIndexArray[1]

    ' Array of targetsets for each focused position in the list.
    m.targetSetArray = []

    for index = 0 to targetsetRects.count() - 1
        focusedTargetSet = createObject("roSGNode", "TargetSet")

        if index >= m.firstVisibleIndex and index <= m.lastVisibleIndex
            focusedTargetSet = createTargetSet({
                focusIndex: index,
                targetRects: targetsetRects[index]
            })
            m.targetSetArray.push(focusedTargetSet)
        end if
    end for

    m.targetsetRects = targetsetRects
end sub



function getVisibleIndices(options = {})
    defaultVisibleIndex = get("defaultVisibleIndex")
    gutterWidth = get("gutterWidth")

    numberOfContentItems = get("totalCarouselItems")
    maxVisibleTiles = get("visibleTiles")
    visibleTiles = numberOfContentItems < maxVisibleTiles ? numberOfContentItems : maxVisibleTiles

    ' By default the first visible rect will be index 1
    ' in order to allow a "staging" rect that is invisible behind the clippingrect
    gutterOffset = 1

    ' If there are gutter rects that act as semi-opaque tiles
    ' then we increase the default visible rect even further
    if gutterWidth > 0 then gutterOffset++

    firstVisibleIndex = defaultVisibleIndex + gutterOffset
    lastVisibleIndex = visibleTiles - 1 + gutterOffset

    return [firstVisibleIndex, lastVisibleIndex]
end function


sub setUnfocusedTargetSet(unfocusedRects = [])
    if get("flushFocus") or not rodash.isNode(m.carousel.targetSet)
        defaultVisibleIndex = get("defaultVisibleIndex") ?? 0
        extraRects = getExtraRectNumber()

        if get("flushFocus") then extraRects = 0

        ' Peel off the first array, which should always be for unfocused targetset
        unFocusedTargetSet = createTargetSet({
            focusIndex: defaultVisibleIndex + extraRects,
            targetRects: unfocusedRects
        })

        ' Set the initial targetset of the list to the unfocused one
        m.carousel.targetSet = unFocusedTargetSet
        m.unFocusedTargetSet = unFocusedTargetSet
    end if
end sub


function createTargetset(options = {})
    targetSet = createObject("roSGNode", "TargetSet")
    targetSet.update(options)
    return targetSet
end function


function returnTargetsetRects(options = {})
    horizontal = get("direction") = "horizontal"
    horizAlign = get("vertAlign") ?? "center"
    vertAlign =  get("vertAlign") ?? "center"

    targetsetRects = []
    extraRects = getExtraRectNumber()
    ?"returnTargetsetRects " extraRects, horizontal


    ' -1 because we want to generate the unfocused state as first array
    for y = -1 to get("totalRects") - 1
        focusedTile = y
        ?"focusedTile " focusedTile
        targetRects = []

        for x = 0 to get("totalRects") - 1
            bigSquare = rectSquare({ type: "big", index: x })
            smallSquare = rectSquare({ type: "small", index: x })

            if horizAlign = "left"
                deltaX = 0
            else if horizAlign = "right"
                deltaX = (bigSquare[0] - smallSquare[0])
            else
                deltaX = (bigSquare[0] - smallSquare[0]) / 2
            end if

            if vertAlign = "top"
                deltaY = 0
            else if vertAlign = "bottom"
                deltaY = (bigSquare[1] - smallSquare[1])
            else
                deltaY = (bigSquare[1] - smallSquare[1]) / 2
            end if

            containerPosition = getStartingPosition({
                extraRects: extraRects,
                horizontal: horizontal,
                index: x,
                square: get("squareTotalArea")
            })

            ?"containerPosition " containerPosition

            square = x = focusedTile ? bigSquare : smallSquare

            offsetX = x = focusedTile ? margins().left : deltaX + margins().left
            offsetY = x = focusedTile ? margins().top : deltaY + margins().top

            targetRects.push({
                x: containerPosition[0] + offsetX,
                y: containerPosition[1] + offsetY,
                width: square[0],
                height: square[1]
            })
        end for

        targetsetRects.push(targetRects)
    end for

    return targetsetRects
end function


function rectSquare(options = {}) as object
    if rodash.isEmpty(options) then return [0, 0]

    squareKey = options.type = "small" ? "smallSquare" : "bigSquare"

    ' if get("flushFocus")
    '     if rodash.isEmpty(top().rectSizes) then return [0, 0]

    '     index = options.index ?? 0
    '     return (top().rectSizes[index] ?? {}).[squareKey] ?? [0, 0]
    ' end if

    return get(squareKey)
end function


' Get the number of extra hidden rects
' for *each side* of the carousel
' meaning ultimately it will be n*2
function getExtraRectNumber(options = {})
    extraRects = 1
    ' if rodash.isEmpty(m.rectConfig) then return extraRects
    ' If there is a gutter, meaning partially visible rects
    ' on each side of the carousel,
    ' then we need to add an extra rect
    ' in order to smoothly load the partially visible rect.
    gutterWidth = get("gutterWidth") ?? 0
    if gutterWidth > 0 then extraRects = 2
    return extraRects
end function


function getStartingPosition(options = {}) as object
    index = options.index ?? 0
    square = options.square ?? {}
    horizontal = options.horizontal ?? false
    ' Because some of the tiles will be hidden
    extraRects = options.extraRects
    ' We need to adjust the index based on the extraRects
    adjustedIndex = index + extraRects * -1

    coordinates = [0, 0]

    if rodash.isEmpty(square) then return coordinates

    if horizontal
        coordinates[0] = adjustedIndex * square.width
    else
        coordinates[1] = adjustedIndex * square.height
    end if

    return coordinates
end function


sub getCarouselDimensions()

end sub

function margins()
    margin = get("squareMargins") ?? 0

    returnObj = {
        "left": 0,
        "top": 0,
        "right": 0,
        "bottom": 0
    }

    if margin.count() = 1
        returnObj["left"] = margin[0]
        returnObj["top"] = margin[0]
        returnObj["right"] = margin[0]
        returnObj["bottom"] = margin[0]
    else if margin.count() = 2 or margin.count() = 3
        returnObj["left"] = margin[0]
        returnObj["top"] = margin[1]
        returnObj["right"] = margin[0]
        returnObj["bottom"] = margin[1]
    else if margin.count() = 4
        returnObj["left"] = margin[3]
        returnObj["top"] = margin[0]
        returnObj["right"] = margin[1]
        returnObj["bottom"] = margin[2]
    end if

    return returnObj
end function


function getHeight() as integer
    if get("flushFocus")
        firstSet = m.targetsetRects[0] ?? []
        lastItem = firstSet[firstSet.count() - 1] ?? { height: 0, width: 0, x: 0, y: 0}

        if get("direction") = "horizontal"
            return lastItem.height
        else
            return get("maxHeight")
        end if
    else
        if get("direction") = "horizontal"
            return get("squareTotalArea").height
        else
            return get("squareTotalArea").height * get("visibleTiles")
        end if
    end if
end function


function getWidth() as integer
    if get("flushFocus")
        if get("direction") = "horizontal"
            return get("maxWidth") ?? 0
        else

            reduction = function(acc, cv, index, arr, args)
                if rodash.isArray(cv)
                    width = CommonUtils_reduce(cv, args.reduction, {reduction: args.reduction}, 0)
                else
                    width = cv.width
                end if

                if width > acc then acc = width
                return acc
            end function

            maxWidth = CommonUtils_reduce(m.targetsetRects, reduction, {reduction: reduction}, 0)

            return maxWidth
        end if
    else
        if get("direction") = "horizontal"
            firstSet = m.targetsetRects[m.lastVisibleIndex] ?? []
            lastItem = firstSet[m.lastVisibleIndex]
            ?"lastItem " lastItem
            ' if not TypeGuard_isEmptyAssocArray(lastItem)
            '     return lastItem.width + lastItem.x
            ' end if
            return get("squareTotalArea").width * get("visibleTiles")
        else
            return get("squareTotalArea").width
        end if
    end if
end function


namespace calculate
    function carouselDimensions(options = {})
        return 0
    end function


    function totalWidth(options = {})
        totalCarouselWidth = 0
        return 0
    end function


    function totalRects()
        return get("totalCarouselItems") + 2
    end function


    function visibleTiles(options = {})
        configMaxTiles = get("visibleTiles") ?? 0
        numberOfItems = get("totalCarouselItems") ?? 0
        return numberOfItems < configMaxTiles ? numberOfItems : configMaxTiles
        ' return true
    end function


    function squareTotalArea()
        return {
                height: get("bigSquare")[1] + margins().top + margins().bottom,
                width: get("bigSquare")[0] + margins().left + margins().right
            }
    end function
end namespace


function CommonUtils_reduce(arr as object, func as function, args as object, initialValue=invalid as dynamic) as dynamic
    if not rodash.isArray(arr) then return invalid

    size = arr.count()
    startAt = 0
    accumulator = initialValue

    if size = 0 then return accumulator

    if accumulator = invalid
        accumulator = arr[0]
        startAt = 1
    end if

    for i = startAt to size - 1
        accumulator = func(accumulator, arr[i], i, arr, args)
    end for

    return accumulator
end function


function CommonUtils_floatMOD(x as dynamic, y as dynamic) as dynamic
    if y = 0 then return 0
    a = abs(x)
    b = abs(y)
    remainder = a - (int(a/b) * b)
    return remainder * sgn(x)
end function

