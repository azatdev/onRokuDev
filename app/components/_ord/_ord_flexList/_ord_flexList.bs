import "pkg:/components/_ord/wrappers.bs"


sub init()
    exec(sub()
        m.clippingRectOutline = top().findNode("clippingRectOutline")
        m.carousel = top().findNode("carousel")
        m.carousel.advancing = true
        m.carousel.reversing = true
        m.carousel.easeFunction = "linear"
        m.carousel.update({ focusPercent: 0.0 }, true)
        m.rectSizes = []
        ' m.carousel.showTargetRects = true

        safeObserve("itemSelected", onItemSelected, m.carousel)
        safeObserve("itemFocused", onItemFocused, m.carousel)
        safeObserve("itemUnfocused", onItemUnfocused, m.carousel)
        safeObserve("focusedChild", onCarouselFocusedChildChange, m.carousel)

        m.initialFocusNode = m.carousel

        set({ defaultConfig: {
            animationDuration: 0.3,
            clip: true,
            carouselType: "default",
            componentName: "",
            defaultVisibleIndex: 0,
            ' lastIndex: 2,
            direction: "horizontal",
            dynamicWidth: false,
            focusType: "floating",
            flushFocus: false,
            gutterSize: 0,
            horizAlign: "center",
            maxHeight: 0,
            maxWidth: 0,
            vertAlign: "center",
            visibleTiles: 0,
            wrap: false,
            bigSquare: [0, 0],
            smallSquare: [0, 0],
            squareMargins: [0, 0],
            squareTotalArea: [0, 0]
        }})

        safeObserve("data", onDataSet)
        safeObserve("focusedChild", onFocusedChildChange)

        safeFunctions({
            registerChildRect: registerChildRect
        })

        m.focusTimer = getFloatFieldInterpolator(m.carousel.getChildren(-1, 0))
    end sub)
end sub


function getFloatFieldInterpolator(children = [])
    for each child in children
        if child.subType() = "FloatFieldInterpolator" then return child
        return getFloatFieldInterpolator(child.getChildren(-1, 0))
    end for
    return invalid
end function


sub onCarouselFocusedChildChange(options = {})
    if not rodash.isNode(m.focusTimer) then return
    safeUnobserve("fraction", m.focusTimer)
    safeObserve("fraction", onTestTimerFired, m.focusTimer)
end sub


sub onTestTimerFired(options = {})
    fraction = options.data
    if rodash.isNode(m.focusTimer) and (fraction = 0 or fraction = 1) then safeUnobserve("fraction", m.focusTimer)

    percentage = m.carousel.isInFocusChain() ? fraction : 1 - fraction

    ' There is a 100ms delay before
    ' TargetGroup animation starts
    rodash.delay(sub(percentage)
        applyClippingRect({ percentage: percentage })
    end sub, 100, percentage)
end sub


function onKeyEvent(key as string, press as boolean) as boolean
    return exec(function(options = {})
        carousel = options.carousel
        key = options.key
        press = options.press

        if not press then return true
        if not rodash.isArray(m.focusedTargetSetArray) then return true
        if not rodash.isNode(carousel) then return true

        if calculate.floatMOD(carousel.currFocusItemIndex, 1) <> 0 then return true
        if key <> top().advanceKey and key <> top().reverseKey then return false

        direction = key = top().reverseKey ? -1 : 1
        currentIndex = top().focusedContentIndex
        lastFocusableIndex = get("lastFocusableIndex")
        nextIndex = currentIndex + direction
        currentTargetSetIndex = top().focusedTargetsetIndex
        nextTargetSetIndex = currentTargetSetIndex + direction

        if nextTargetSetIndex <= 0 then nextTargetSetIndex = 0
        if nextTargetSetIndex >= lastFocusableIndex then nextTargetSetIndex = lastFocusableIndex

        if carousel.content.getChild(nextIndex) = invalid
            if not get("wrap") then return false

            if direction = 1
                nextIndex = 0
                nextTargetSetIndex = 0
            else
                profilesCollection = carousel.content
                if not rodash.isNode(profilesCollection) then return true
                nextIndex = profilesCollection.getChildCount() - 1
                nextTargetSetIndex = m.focusedTargetSetArray.count() - 1
            end if
        end if

        nextTargetSet = m.focusedTargetSetArray[nextTargetSetIndex]

        if nextTargetSet <> invalid and carousel.currTargetSet <> invalid and nextTargetSet.focusIndex <> carousel.currTargetSet.focusIndex
            carousel.animateToTargetSet = nextTargetSet
            top().focusedTargetsetIndex = nextTargetSetIndex
        end if

        carousel.animateToItem = nextIndex
        top().focusedContentIndex = nextIndex

        return true
    end function, { carousel: m.carousel, key: key, press: press })
end function


sub applyClippingRect(options = {})
    if not get("clip") then return

    percentage = options.percentage
    percentage = percentage < 0 ? 0 : percentage
    percentage = percentage > 1 ? 1 : percentage
    direction = get("direction") ?? "horizontal"
    focusedClippingRect = get("focusedClippingRect")
    unfocusedClippingRect = get("unfocusedClippingRect")

    if focusedClippingRect = invalid then return
    if unfocusedClippingRect = invalid then return

    deltaX = focusedClippingRect[0] - unfocusedClippingRect[0]
    deltaY = focusedClippingRect[1] - unfocusedClippingRect[1]
    deltaWidth = focusedClippingRect[2] - unfocusedClippingRect[2]
    deltaHeight = focusedClippingRect[3] - unfocusedClippingRect[3]

    newClippingRect = [
        deltaX * percentage + unfocusedClippingRect[0],
        deltaY * percentage + unfocusedClippingRect[1],
        deltaWidth * percentage + unfocusedClippingRect[2],
        deltaHeight * percentage + unfocusedClippingRect[3]
    ]

    if direction = "horizontal"
        newClippingRect[2] -= (deltaX * percentage + unfocusedClippingRect[0])
    else
        newClippingRect[3] -= (deltaY * percentage + unfocusedClippingRect[1])
    end if

    m.clippingRectOutline.width = newClippingRect[2]
    m.clippingRectOutline.height = newClippingRect[3]
    m.clippingRectOutline.translation = [newClippingRect[0], newClippingRect[1]]

    top().width = focusedClippingRect[2]
    top().height = focusedClippingRect[3]
    top().clippingRect = newClippingRect
end sub


function applyGutters(options = {})
    if not rodash.isNonEmptyAA(options) then return [0,0,0,0]
    clippingRect = options.clippingRect ?? [0,0,0,0]
    direction = options.direction ?? "horizontal"
    gutters = options.gutters ?? calculate.quadruple({ value: 0 })

    clippingRect[0] -= gutters.left
    clippingRect[1] -= gutters.top
    clippingRect[2] += gutters.right
    clippingRect[3] += gutters.bottom

    if direction = "horizontal"
        clippingRect[3] += gutters.top
    else
        clippingRect[2] += gutters.left
    end if

    return clippingRect
end function


sub setClippingRects(options = {})
    if not rodash.isNonEmptyAA(options) then return
    clippingRects = options.clippingRects ?? {}
    direction = options.direction
    dynamicWidth = options.dynamicWidth ?? false
    gutters = options.gutters
    maxWidth = options.maxWidth ?? 0
    index = direction = "horizontal" ? 2 : 3

    unfocusedClippingRect = clippingRects.shift()
    focusedClippingRect = clippingRects[0]

    if dynamicWidth and maxWidth > 0
        focusedClippingRect[index] = maxWidth
        unfocusedClippingRect[index] = maxWidth
    end if

    set({
        unfocusedClippingRect: applyGutters({
            clippingRect: unfocusedClippingRect,
            direction: direction,
            gutters: gutters
        })
    })

    for each clippingRect in clippingRects
        if clippingRect[2] > focusedClippingRect[2] then focusedClippingRect[2] = clippingRect[2]
    end for

    set({
        focusedClippingRect: applyGutters({
            clippingRect: focusedClippingRect,
            direction: direction,
            gutters: options.gutters
        })
    })
end sub


sub onFocusedChildChange(options = {})
    node = options.data
    currentIndex = top().focusedContentIndex
    if m.content = invalid then return

    unfocused = node = invalid or not node.isSameNode(m.top) and not top().isInFocusChain()

    if not rodash.isNode(m.carousel.targetSet) then return

    if unfocused
        unFocusedTargetSet = get("dynamicWidth") ? m.carousel.targetSet : m.unFocusedTargetSet
        unFocusedTargetSet.focusIndex = m.carousel.targetSet.focusIndex
        rodash.delay(sub(args)
            args[0].animateToTargetSet = args[1]
        end sub, 100, [m.carousel, unFocusedTargetSet])
        m.carousel.animateToItem = currentIndex
        return
    end if

    if not rodash.isArray(m.focusedTargetSetArray) then return

    currentTargetSet = m.focusedTargetSetArray[top().focusedTargetsetIndex]
    m.carousel.animateToItem = currentIndex

    rodash.delay(sub(args)
        args[0].animateToTargetSet = args[1]
    end sub, 100, [m.carousel, currentTargetSet])

    m.carousel.setFocus(true)
end sub


sub onDataSet(options = {})
    if not rodash.isNonEmptyAA(options) then return

    data = options.data ?? {}
    content = data.content
    if not rodash.isNode(content) then return

    safeObserve("totalCount", onTotalCountChange, content)
    safeObserve("rectConfig", processConfig, content)

    m.content = content
    m.carousel.content = content
    m.carousel.itemComponentName = content.rectConfig.itemComponentName

    if rodash.isBoolean(content.rectConfig.dynamicWidth) and content.rectConfig.dynamicWidth
        rects = []
        for x = 0 to m.content.getChildCount() -1
            rects.push({
                height: 1,
                width: 1,
                x: 0,
                y: 0
            })
        end for
        unFocusedTargetSet = createTargetSet({
            focusIndex: 0,
            targetRects: rects
        })
        m.carousel.targetSet = unFocusedTargetSet
    else
        processConfig({ data: content.rectConfig })
    end if
end sub


sub onTotalCountChange(options = {})
    if not rodash.isNonEmptyAA(options) then return
    totalCarouselItems = options.data
    if rodash.isNumber(totalCarouselItems) then set({ totalCarouselItems: totalCarouselItems })
    processConfig()
end sub


sub onItemFocused(options = {})
    if not rodash.isNonEmptyAA(options) then return
    m.top.itemFocused = options.data
end sub


sub onItemSelected(options = {})
    if not rodash.isNonEmptyAA(options) then return
    m.top.itemSelected = options.data
end sub


sub onItemUnfocused(options = {})
    if not rodash.isNonEmptyAA(options) then return
    m.top.itemUnfocused = options.data
end sub


sub processConfig(options = {})
    if not rodash.isNonEmptyAA(options) then return
    if not rodash.isNode(m.content) then return

    defaultConfig = get("defaultConfig")
    config = {}
    config.append(defaultConfig)
    config.append(options.data ?? {})

    totalCarouselItems = m.content.totalCount ?? 0
    margins = calculate.quadruple({ value: config.squareMargins })
    gutters = calculate.quadruple({ value: config.gutterSize })

    rectSizes = processRectSizes({
        bigSquare: config.bigSquare,
        margins: margins,
        smallSquare: config.smallSquare
    })

    maxVisibleTiles = calculate.maxVisibleTiles({
        totalCarouselItems: totalCarouselItems,
        visibleTiles: config.visibleTiles
    })
    extraRects = calculate.extraRectNumber({
        direction: config.direction,
        dynamicWidth: config.dynamicWidth,
        gutters: gutters,
        rectSizes: rectSizes
    })
    totalRects = calculate.totalRects({ extraRects: extraRects, visibleTiles: maxVisibleTiles })

    ' Calculate the first and last visible rects
    ' accounting for extra gutter rects
    focusableIndexArray = getVisibleIndices({
        defaultVisibleIndex: config.defaultVisibleIndex ?? 0,
        extraRects: extraRects,
        totalCarouselItems: totalCarouselItems,
        visibleTiles: maxVisibleTiles
    })

    firstFocusableIndex = focusableIndexArray[0]
    lastFocusableIndex = focusableIndexArray[1]

    generateRects({
        carouselType: config.carouselType,
        defaultVisibleIndex: config.defaultVisibleIndex,
        direction: config.direction,
        dynamicWidth: config.dynamicWidth,
        extraRects: extraRects,
        firstFocusableIndex: firstFocusableIndex,
        flushFocus: config.flushFocus,
        focusType: config.focusType,
        gutters: gutters,
        horizAlign: config.horizAlign,
        lastFocusableIndex: lastFocusableIndex,
        margins: margins,
        maxWidth: config.maxWidth,
        rectSizes: rectSizes,
        totalRects: totalRects,
        vertAlign: config.vertAlign
    })

    setListContent({
        animationDuration: config.animationDuration,
        itemComponentName: config.itemComponentName
    })

    if config.direction = "vertical"
        top().reverseKey = "up"
        top().advanceKey = "down"
    else
        top().reverseKey = "left"
        top().advanceKey = "right"
    end if

    set({
        clip: config.clip,
        direction: config.direction,
        dynamicWidth: config.dynamicWidth,
        extraRects: extraRects,
        focusableIndexArray: focusableIndexArray,
        gutters: gutters,
        lastFocusableIndex: lastFocusableIndex,
        wrap: config.wrap
    })

    applyClippingRect({ percentage: 0 })
end sub


function processRectSizes(options = {})
    bigSquare = options.bigSquare
    margins = options.margins
    smallSquare = options.smallSquare
    rectSizes = m.rectSizes ?? []

    if not rodash.isNonEmptyArray(rectSizes)
        rectSizes = [{
            bigSquare: bigSquare,
            smallSquare: smallSquare
        }]
    end if

    for each rectSet in rectSizes
        rectSet.totalArea = calculate.squareTotalArea({
            bigSquare: rectSet.bigSquare,
            margins: margins
        })
    end for

    return rectSizes
end function


sub registerChildRect(options = {})
    m.rectSizes[options.index] = {
        smallSquare: options.smallSquare,
        bigSquare: options.bigSquare
    }
    if m.rectSizes.count() = m.content.getChildCount()
        processConfig({ data: m.content.rectConfig })
    end if
end sub


sub setListContent(options = {})
    m.carousel.content = m.content
    m.carousel.itemComponentName = options.itemComponentName
    m.carousel.duration = options.animationDuration ?? 0.3
end sub


sub generateRects(options = {})
    carouselType = options.carouselType
    defaultVisibleIndex = options.defaultVisibleIndex
    direction = options.direction
    dynamicWidth = options.dynamicWidth
    extraRects = options.extraRects
    firstFocusableIndex = options.firstFocusableIndex
    flushFocus = options.flushFocus
    focusType = options.focusType
    gutters = options.gutters
    lastFocusableIndex = options.lastFocusableIndex
    maxWidth = options.maxWidth

    if carouselType = "flushFocus"
        rects = returnFlushRects({
            direction: direction,
            extraRects: extraRects,
            horizAlign: options.horizAlign,
            margins: options.margins,
            rectSizes: options.rectSizes,
            totalRects: options.totalRects,
            vertAlign: options.vertAlign
        })
    else if carouselType = "dynamicSize"
        rects = returnDynamicRects({
            direction: direction,
            extraRects: extraRects,
            gutters: gutters,
            margins: options.margins,
            maxWidth: maxWidth,
            rectSizes: options.rectSizes,
            totalRects: options.totalRects
        })
    else
        rects = returnDefaultRects({
            direction: direction,
            extraRects: extraRects,
            horizAlign: options.horizAlign,
            margins: options.margins,
            rectSizes: options.rectSizes,
            totalRects: options.totalRects,
            vertAlign: options.vertAlign
        })
    end if

    targetsetRects = rects.targetsetRects
    clippingRects = rects.clippingRects

    unfocusedRects = targetsetRects.shift()
    setUnfocusedTargetSet({
        defaultVisibleIndex: defaultVisibleIndex,
        extraRects: extraRects,
        flushFocus: flushFocus,
        unfocusedRects: unfocusedRects
    })

    setClippingRects({
        clippingRects: clippingRects,
        direction: direction,
        dynamicWidth: dynamicWidth,
        gutters: gutters,
        maxWidth: maxWidth
    })
    ' Array of targetsets for each focused position in the list.
    m.focusedTargetSetArray = []

    if focusType = "fixed"
        index = defaultVisibleIndex + extraRects
        focusedTargetSet = createTargetSet({
            focusIndex: index,
            targetRects: targetsetRects[index]
        })
        m.focusedTargetSetArray.push(focusedTargetSet)
    else
        for index = 0 to targetsetRects.count() - 1
            focusedTargetSet = createObject("roSGNode", "TargetSet")

            if index >= firstFocusableIndex and index <= lastFocusableIndex
                focusedTargetSet = createTargetSet({
                    focusIndex: index,
                    targetRects: targetsetRects[index]
                })
                m.focusedTargetSetArray.push(focusedTargetSet)
            end if
        end for
    end if

    m.targetsetRects = targetsetRects
end sub


function getVisibleIndices(options = {})
    if not rodash.isNonEmptyAA(options) then return [0,0]
    defaultVisibleIndex = options.defaultVisibleIndex
    extraRects = options.extraRects

    maxVisibleTiles = options.visibleTiles
    numberOfContentItems = options.totalCarouselItems
    visibleTiles = numberOfContentItems < maxVisibleTiles ? numberOfContentItems : maxVisibleTiles

    firstFocusableIndex = defaultVisibleIndex + extraRects
    lastFocusableIndex = visibleTiles - 1 + extraRects

    return [firstFocusableIndex, lastFocusableIndex]
end function


sub setUnfocusedTargetSet(options = {})
    defaultVisibleIndex = options.defaultVisibleIndex
    extraRects = options.extraRects
    flushFocus = options.flushFocus
    unfocusedRects = options.unfocusedRects

    if flushFocus or not rodash.isNode(m.carousel.targetSet)
        ' Peel off the first array, which should always be for unfocused targetset
        unFocusedTargetSet = createTargetSet({
            focusIndex: defaultVisibleIndex + extraRects,
            targetRects: unfocusedRects
        })
        ' Set the initial targetset of the list to the unfocused one
        m.carousel.targetSet = unFocusedTargetSet
        m.unFocusedTargetSet = unFocusedTargetSet
    end if
end sub


function createTargetset(options = {})
    targetSet = createObject("roSGNode", "TargetSet")
    targetSet.update(options)
    return targetSet
end function


function returnDefaultRects(options = {})
    direction = options.direction
    extraRects = options.extraRects
    horizAlign = options.horizAlign
    margins = options.margins
    rectSizes = options.rectSizes
    totalRects = options.totalRects
    vertAlign = options.vertAlign
    horizontal = direction = "horizontal"
    targetRectIndex = horizontal ? 0 : 1
    targetDimension = horizontal ? "width" : "height"

    clippingRects = []
    targetsetRects = []

    for y = -1 to totalRects - 1
        focusedTile = y
        targetRects = []
        clippingRect = [0, 0, 0, 0]
        startingPosition = 0

        for x = 0 to totalRects - 1
            rectSize = rectSizes[x] ?? rectSizes[0]
            bigSquare = rectSize.bigSquare
            smallSquare = rectSize.smallSquare
            totalArea = rectSize.totalArea
            lastVisibleIndex = totalRects - (extraRects * 2)

            adjustedPosition = startingPosition - (extraRects * totalArea[targetDimension])

            square = x = focusedTile ? bigSquare : smallSquare

            if horizAlign = "left"
                deltaX = 0
            else if horizAlign = "right"
                deltaX = (bigSquare[0] - smallSquare[0])
            else
                deltaX = (bigSquare[0] - smallSquare[0]) / 2
            end if

            if vertAlign = "top"
                deltaY = 0
            else if vertAlign = "bottom"
                deltaY = (bigSquare[1] - smallSquare[1])
            else
                deltaY = (bigSquare[1] - smallSquare[1]) / 2
            end if

            containerPosition = [0, 0]
            containerPosition[targetRectIndex] = adjustedPosition

            offsetX = x = focusedTile ? margins.left : deltaX + margins.left
            offsetY = x = focusedTile ? margins.top : deltaY + margins.top

            targetRect = {
                x: containerPosition[0] + offsetX,
                y: containerPosition[1] + offsetY,
                width: square[0],
                height: square[1]
            }
            targetRects.push(targetRect)

            if x <= lastVisibleIndex
                if horizontal
                    clippingRect[2] = startingPosition
                    clippingRect[3] = totalArea.height
                else
                    clippingRect[2] = totalArea.width
                    clippingRect[3] = startingPosition
                end if
            end if

            startingPosition += totalArea[targetDimension]
        end for

        targetsetRects.push(targetRects)
        clippingRects.push(clippingRect)
    end for

    return {
        "targetsetRects": targetsetRects,
        "clippingRects": clippingRects
    }
end function

function returnFlushRects(options = {})
    direction = options.direction
    extraRects = options.extraRects
    horizAlign = options.horizAlign
    margins = options.margins
    rectSizes = options.rectSizes
    totalRects = options.totalRects
    vertAlign = options.vertAlign

    horizontal = direction = "horizontal"
    primaryArrayIndex = horizontal ? 0 : 1
    secondaryArrayIndex = horizontal ? 1 : 0
    targetRectIndex = horizontal ? 0 : 1

    clippingRects = []
    targetsetRects = []

    for y = -1 to totalRects - 1
        focusedTile = y
        targetRects = []
        clippingRect = [0, 0, 0, 0]
        startingPosition = 0

        for x = 0 to totalRects - 1
            rectSize = rectSizes[x] ?? rectSizes[0]
            bigSquare = rectSize.bigSquare
            smallSquare = rectSize.smallSquare

            square = x = focusedTile ? bigSquare : smallSquare

            if horizAlign = "left"
                deltaX = 0
            else if horizAlign = "right"
                deltaX = (bigSquare[0] - smallSquare[0])
            else
                deltaX = (bigSquare[0] - smallSquare[0]) / 2
            end if

            if vertAlign = "top"
                deltaY = 0
            else if vertAlign = "bottom"
                deltaY = (bigSquare[1] - smallSquare[1])
            else
                deltaY = (bigSquare[1] - smallSquare[1]) / 2
            end if

            adjustedPosition = startingPosition - (extraRects * smallSquare[targetRectIndex])
            deltaArray = [deltaX, deltaY]

            containerPosition = [0, 0]

            containerPosition[primaryArrayIndex] = adjustedPosition
            containerPosition[secondaryArrayIndex] = deltaArray[secondaryArrayIndex]

            if focusedTile = -1
                containerPosition[primaryArrayIndex] += deltaArray[primaryArrayIndex] / 2
            else if x = focusedTile
                containerPosition[secondaryArrayIndex] = 0
            end if

            targetRect = {
                x: containerPosition[0],
                y: containerPosition[1],
                width: square[0],
                height: square[1]
            }

            targetRects.push(targetRect)

            startingPosition += square[targetRectIndex]

            clippingRect = calculate.dynamicClippingRect({
                existingClippingRect: clippingRect,
                firstVisibleIndex: extraRects,
                horizontal: horizontal,
                lastVisibleIndex: totalRects - extraRects - 1,
                rectIndex: x,
                targetRect: targetRect,
                targetSetIndex: y
            })
        end for

        clippingRects.push(clippingRect)
        targetsetRects.push(targetRects)
    end for

    return {
        "targetsetRects": targetsetRects,
        "clippingRects": clippingRects
    }
end function


function returnDynamicRects(options = {})
    direction = options.direction
    extraRects = options.extraRects
    gutters = options.gutters
    margins = options.margins
    maxWidth = options.maxWidth
    rectSizes = options.rectSizes
    totalRects = options.totalRects

    targetsetRects = []
    clippingRects = []

    horizontal = direction = "horizontal"
    targetRectIndex = horizontal ? 0 : 1

    ' -1 because we want to generate the unfocused state as first array
    for y = -1 to totalRects - 1
        targetRects = []
        clippingRect = [0, 0, 0, 0]
        startingPosition = 0

        for x = 0 to totalRects - 1
            rectSize = rectSizes[x] ?? rectSizes[0]
            totalArea = rectSize.totalArea
            previousRect = targetRects[x - 1]
            adjustedIndex = x + extraRects * -1
            rect = rectSizes[adjustedIndex]
            lastVisibleIndex = totalRects - (extraRects * 2)

            if not rodash.isNonEmptyAA(rect) then rect = {
                bigSquare: [0, 0],
                smallSquare: [0, 0]
            }

            square = x <> y or y = -1 ? rect.smallSquare : rect.bigSquare

            containerPosition = [0, 0]
            if rodash.isNonEmptyAA(previousRect)
                if direction = "horizontal"
                    containerPosition[targetRectIndex] = previousRect.x + previousRect.width + margins.left + margins.right
                else
                    containerPosition[targetRectIndex] = previousRect.y + previousRect.height + margins.top + margins.bottom
                end if
            end if

            targetRect = {
                height: square[1] ?? 0,
                width: square[0] ?? 0,
                x: containerPosition[0],
                y: containerPosition[1]
            }

            targetRects.push(targetRect)

            if x <= lastVisibleIndex
                if horizontal
                    clippingRect[2] = startingPosition
                    clippingRect[3] = totalArea.height
                else
                    clippingRect[2] = totalArea.width
                    clippingRect[3] = startingPosition
                end if
            end if
        end for

        clippingRects.push(clippingRect)

        targetRects = calculate.adjustedDynamicRects({
            direction: direction,
            gutters: gutters,
            maxWidth: maxWidth,
            targetRects: targetRects,
            targetSetIndex: y
        })

        targetsetRects.push(targetRects)
    end for

    return {
        "targetsetRects": targetsetRects,
        "clippingRects": clippingRects
    }
end function


namespace calculate
    function adjustedDynamicRects(options = {})
        direction = options.direction
        gutters = options.gutters
        maxWidth = options.maxWidth
        targetRects = options.targetRects ?? {}
        targetSetIndex = options.targetSetIndex ?? {}
        targetAxis = direction = "horizontal" ? "x" : "y"
        targetDimension = direction = "horizontal" ? "width" : "height"
        guttersKey = direction = "horizontal" ? "right" : "bottom"

        if targetSetIndex = -1 then return targetRects

        itemThreshold = targetRects[targetSetIndex][targetAxis] + targetRects[targetSetIndex][targetDimension]

        adjustedRects = []

        if itemThreshold < maxWidth then return targetRects

        sizeDelta = maxWidth - itemThreshold
        sizeDelta -= gutters[guttersKey]

        for each rect in targetRects
            newRect = {}
            newRect.append(rect)
            newRect[targetAxis] += sizeDelta
            adjustedRects.push(newRect)
        end for

        return adjustedRects
    end function


    function dynamicClippingRect(options = {})
        clippingRect = options.existingClippingRect
        firstVisibleIndex = options.firstVisibleIndex
        horizontal = options.horizontal
        lastVisibleIndex = options.lastVisibleIndex
        rectIndex = options.rectIndex
        targetRect = options.targetRect
        targetSetIndex = options.targetSetIndex

        ' clippingRect = [0, 0, 0, 0]

        if targetSetIndex = -1
            if rectIndex = firstVisibleIndex
                if targetRect.x >= 0 and targetRect.x > clippingRect[0] then clippingRect[0] = targetRect.x
                if targetRect.y >= 0 and targetRect.y > clippingRect[1] then clippingRect[1] = targetRect.y
            end if

            if rectIndex <= lastVisibleIndex
                if horizontal
                    rectsLastX = targetRect.width + targetRect.x
                else
                    rectsLastX = targetRect.width
                end if

                if clippingRect[2] < rectsLastX then clippingRect[2] = rectsLastX

                if horizontal
                    rectsLastY = targetRect.height
                else
                    rectsLastY = targetRect.height + targetRect.y
                end if

                if clippingRect[3] < rectsLastY then clippingRect[3] = rectsLastY
            end if
        else if targetSetIndex <> -1 and rectIndex <= lastVisibleIndex
            clippingRect[0] = 0
            clippingRect[1] = 0

            if horizontal
                rectsLastX = targetRect.width + targetRect.x
            else
                rectsLastX = targetRect.width
            end if

            if clippingRect[2] < rectsLastX then clippingRect[2] = rectsLastX

            if horizontal
                rectsLastY = targetRect.height
            else
                rectsLastY = targetRect.y + targetRect.height
            end if

            if clippingRect[3] < rectsLastY then clippingRect[3] = rectsLastY
        end if

        return clippingRect
    end function


    ' Get the number of extra hidden rects
    ' for *each side* of the carousel
    ' meaning ultimately it will be n*2
    function extraRectNumber(options = {})
        if not rodash.isNonEmptyAA(options) then return 0

        direction = options.direction
        dynamicWidth = options.dynamicWidth ?? false
        gutters = options.gutters
        rectSizes = options.rectSizes
        squareArea = rectSizes[0].totalArea ?? { height: 0, width: 0 }
        defaultExtraRect = 1
        if not rodash.isNonEmptyAA(squareArea) then return 0
        if dynamicWidth then return 1
        ' If there is a gutter, meaning partially visible rects
        ' on each side of the carousel,
        ' then we need to add an extra rects
        ' in order to smoothly load the partially visible rect.

        gutterSize = 0

        if direction = "horizontal"
            gutterSize = gutters.left > gutters.right ? gutters.left : gutters.right
        else
            gutterSize = gutters.top > gutters.bottom ? gutters.top : gutters.bottom
        end if

        if gutterSize <= 0 then return defaultExtraRect

        rectSize = squareArea[direction = "horizontal" ? "width" : "height"]
        percentageOfSquareAsGutter = gutterSize / rectSize
        numberOfVisibleGutterSquares = int(percentageOfSquareAsGutter) + 1

        return numberOfVisibleGutterSquares + defaultExtraRect
    end function


    function floatMod(x as dynamic, y as dynamic)
        if y = 0 then return 0
        a = abs(x)
        b = abs(y)
        remainder = a - (int(a/b) * b)
        return remainder * sgn(x)
    end function


    function rectStartingPosition(options = {})
        coordinates = [0, 0]
        if not rodash.isNonEmptyAA(options) then return coordinates

        ' Because some of the tiles will be hidden
        extraRects = options.extraRects
        horizontal = options.horizontal ?? false
        index = options.index ?? 0
        rect = options.square ?? {}
        ' We need to adjust the index based on the extraRects
        adjustedIndex = index + extraRects * -1

        if rodash.isEmpty(rect) then return coordinates

        if horizontal
            coordinates[0] = adjustedIndex * rect.width
        else
            coordinates[1] = adjustedIndex * rect.height
        end if

        return coordinates
    end function


    function quadruple(options = {})
        returnObj = {
            "left": 0,
            "top": 0,
            "right": 0,
            "bottom": 0
        }
        if not rodash.isNonEmptyAA(options) then return returnObj

        if rodash.isNumber(options.value)
            value = [options.value]
        else
            value = options.value ?? [0]
        end if

        if value.count() = 1
            returnObj["left"] = value[0]
            returnObj["top"] = value[0]
            returnObj["right"] = value[0]
            returnObj["bottom"] = value[0]
        else if value.count() = 2 or value.count() = 3
            returnObj["left"] = value[0]
            returnObj["top"] = value[1]
            returnObj["right"] = value[0]
            returnObj["bottom"] = value[1]
        else if value.count() = 4
            returnObj["left"] = value[3]
            returnObj["top"] = value[0]
            returnObj["right"] = value[1]
            returnObj["bottom"] = value[2]
        end if

        return returnObj
    end function


    function maxVisibleTiles(options = {})
        if not rodash.isNonEmptyAA(options) then return 0
        configMaxTiles = options.visibleTiles ?? 0
        numberOfItems = options.totalCarouselItems ?? 0
        return numberOfItems < configMaxTiles ? numberOfItems : configMaxTiles
    end function


    function squareTotalArea(options = {})
        if not rodash.isNonEmptyAA(options) then return 0

        bigSquare = options.bigSquare
        squareMargins = options.margins

        return {
            height: bigSquare[1] + squareMargins.top + squareMargins.bottom,
            width: bigSquare[0] + squareMargins.left + squareMargins.right
        }
    end function


    function totalRects(options = {})
        if not rodash.isNonEmptyAA(options) then return 0
        extraRects = options.extraRects ?? 0
        visibleTiles = options.visibleTiles ?? {}
        return visibleTiles + (extraRects * 2)
    end function
end namespace
