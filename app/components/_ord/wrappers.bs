import "init.bs"

sub registerControllers(controllers = [])
    if not rodash.isNonEmptyArray(controllers) then return
    if not m.top.isSubtype("Scene") then return

    for each controllerName in controllers
        updateObject = {}
        updateObject[controllerName] = createObject("roSGNode", controllerName)
        set(updateObject)
    end for
end sub


function safeFunctions(options = {})
    interface = m.interfaceFunctions["safeFunctions"]
    if interface = invalid then return invalid
    return interface.safeFunctions(options)
end function


function devMode()
    return true
end function


function app()
    return m.global.getScene()
end function


function user()
    return get("UserController", app())
end function


function exec(func, options = {}, node = m.top, externalInterface = {})

    if not m.top.hasField("_ord_initiated") or not m.top._ord_initiated then ord_init()

    if not rodash.isNonEmptyAA(m.interfaceFunctions) then return invalid

    interface = m.interfaceFunctions["exec"]
    if interface = invalid then return invalid

    return interface.exec({
        func: func,
        options: options,
        node: node,
        externalInterface: externalInterface
    })
end function


function safeFunc(functionName = "")
    interface = m.interfaceFunctions["safeFunc"]
    if interface = invalid then return invalid
    return interface.safeFunc(functionName)
end function


