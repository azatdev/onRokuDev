import "init.bs"

sub registerControllers(controllers = [])
    if not rodash.isNonEmptyArray(controllers) then return
    if not m.top.isSubtype("Scene") then return

    m.controllers = []

    for each controllerName in controllers
        m.controllers.push(createObject("roSGNode", controllerName))
    end for
end sub


function safeFunctions(options = {})
    interface = m.interfaceFunctions["safeFunctions"]
    if interface = invalid then return invalid
    return interface.safeFunctions(options)
end function


function devMode()
    return true
end function


function app()
    return m.global.getScene()
end function


function exec(func, options = {}, node = m.top, externalInterface = {})

    if not m.top.hasField("_ord_initiated") or not m.top._ord_initiated then ord_init()

    if not rodash.isNonEmptyAA(m.interfaceFunctions) then return invalid

    interface = m.interfaceFunctions["exec"]
    if interface = invalid then return invalid

    return interface.exec({
        func: func,
        options: options,
        node: node,
        externalInterface: externalInterface
    })
end function


function safeFunc(functionName = "")
    interface = m.interfaceFunctions["safeFunc"]
    if interface = invalid then return invalid
    return interface.safeFunc(functionName)
end function


function safeObserve(fieldName = "", callbackFunc = "", node = m.top, infoFields = [])
    interface = m.interfaceFunctions["safeObserve"]
    if interface = invalid then return invalid
    return interface.safeObserve(fieldName, callbackFunc, node, infoFields)
end function


function setTaskFunction(taskFunction = invalid)
    if not rodash.isFunction(taskFunction) then return invalid
    interface = m.interfaceFunctions["setTaskFunction"]
    return interface.setTaskFunction({ function: taskFunction })
end function



function get(options, node = m.top)
    interface = m.interfaceFunctions["get"]
    if interface = invalid then return invalid
    return interface.get(options, node)
end function


function set(options = {}, node = m.top)
    interface = m.interfaceFunctions["set"]
    if interface = invalid then return invalid
    return interface.set(options, node)
end function


function publish(name = "", options = {})
    interface = m.interfaceFunctions["publish"]
    if interface = invalid then return invalid
    return interface.publish({
        id: name,
        options: options
    })
end function


function subscribe(options)
    interface = m.interfaceFunctions["subscribe"]
    if interface = invalid then return invalid
    return interface.subscribe(options)
end function


function setStyles(options, node = m.top)
    interface = m.interfaceFunctions["setStyles"]
    if interface = invalid then return invalid
    return interface.setStyles(options, node)
end function


function dispatch(eventId, options, node = m.top)
    interface = m.interfaceFunctions["dispatch"]
    if interface = invalid then return invalid
    return interface.dispatch({
        id: eventId,
        options: options
    })
end function


function top()
    return getGlobalAA().top
end function


function global()
    return getGlobalAA().global
end function


function runTask()
    if not rodash.isFunction(m._ord_taskFunction) then return invalid
    return exec(m._ord_taskFunction)
end function


sub onError(e)
    ?"ERROR: " formatJSON(e)
end sub
