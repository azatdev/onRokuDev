import "init.bs"

sub registerControllers(controllers = [])
    if not rodash.isNonEmptyArray(controllers) then return
    if not top().isSubtype("Scene") then return

    for each controllerName in controllers
        updateObject = {}
        updateObject[controllerName] = createObject("roSGNode", controllerName)
        set(updateObject)
    end for
end sub


function safeFunctions(options = {})
    interface = m.ord_interfaces["safeFunctions"]
    if interface = invalid then return invalid
    return interface.safeFunctions(options)
end function


function devMode()
    return true
end function


function app()
    return m.global.getScene()
end function


function user()
    return get("UserController", app())
end function


function safeFunc(functionName = "")
    interface = m.ord_interfaces["safeFunc"]
    if interface = invalid then return invalid
    return interface.safeFunc(functionName)
end function


function safeObserve(fieldName = "", callbackFunc = "", node = top(), infoFields = [])
    interface = m.ord_interfaces["safeObserve"]
    if interface = invalid then return invalid
    return interface.safeObserve(fieldName, callbackFunc, node, infoFields)
end function


function safeUnobserve(fieldName = "", node = top())
    interface = m.ord_interfaces["safeUnobserve"]
    if interface = invalid then return invalid
    return interface.safeUnobserve(fieldName, node)
end function


function setTaskFunction(taskFunction = invalid)
    if not rodash.isFunction(taskFunction) then return invalid
    interface = m.ord_interfaces["setTaskFunction"]
    return interface.setTaskFunction({ function: taskFunction })
end function


function get(options, node = top())
    interface = m.ord_interfaces["get"]
    if interface = invalid then return invalid
    return interface.get(options, node)
end function


function set(options = {}, node = top())
    interface = m.ord_interfaces["set"]
    if interface = invalid then return invalid
    return interface.set(options, node)
end function


