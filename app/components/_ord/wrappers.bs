function runTask()
    if not rodash.isFunction(m._ord_taskFunction) then return invalid
    return exec(m._ord_taskFunction)
end function


sub onError(e)
    'bs:disable-next-line
    ?"ERROR: " formatJSON(e)
end sub


sub stackChildren(options = {})
    node = options.node ?? m.top
    children = node.getChildren(-1, 0)
    totalHeight = 0
    totalWidth = 0
    direction = options.direction ?? "horizontal"
    horizontal = direction = "horizontal"

    for each child in children
        if not child.isSubtype("Group") then continue for
        childMargins = quadrupleMargins(child.margin)

        topMargin = childMargins.top
        leftMargin = childMargins.left

        childHeight = getVisibleHeight(child)
        childWidth = getVisibleWidth(child)

        if horizontal
            if childWidth = 0 then continue for
            child.translation = [totalWidth + leftMargin, child.translation[1]]
            totalWidth += childWidth
        else
            if childHeight = 0 then continue for
            child.translation = [child.translation[0], totalHeight + topMargin]
            totalHeight += childHeight
        end if
    end for

    minWidth = node.minWidth ?? 0
    minHeight = node.minHeight ?? 0

    if horizontal
        node.width = totalWidth > minWidth ? totalWidth : minWidth
        node.height = node.boundingRect().height
    else
        node.height = totalHeight > minHeight ? totalHeight : minHeight
        node.width = node.boundingRect().width
    end if
end sub


function quadrupleMargins(margin)
    returnObj = {
        "left": 0,
        "top": 0,
        "right": 0,
        "bottom": 0
    }

    if margin = invalid then return returnObj

    if rodash.isNumber(margin) then margin = [margin]
    if rodash.isString(margin) then margin = [val(margin)]

    if margin.count() = 1
        returnObj["left"] = margin[0]
        returnObj["top"] = margin[0]
        returnObj["right"] = margin[0]
        returnObj["bottom"] = margin[0]
    else if margin.count() = 2 or margin.count() = 3
        returnObj["left"] = margin[0]
        returnObj["top"] = margin[1]
        returnObj["right"] = margin[0]
        returnObj["bottom"] = margin[1]
    else if margin.count() = 4
        returnObj["left"] = margin[3]
        returnObj["top"] = margin[0]
        returnObj["right"] = margin[1]
        returnObj["bottom"] = margin[2]
    end if

    return returnObj
end function


function getVisibleHeight(node)
    if not rodash.isNode(node) then return 0

    nodeHeight = 0
    clippingRect = node.clippingRect
    boundingRect = node.boundingRect()
    nodeMargins = quadrupleMargins(node.margin)

    if not node.visible then return 0
    if not rodash.isNonEmptyAA(clippingRect) then return 0

    if clippingRect.height > 0
        nodeHeight = clippingRect.height
    else if rodash.isNumber(node.height) and node.height > 0
        nodeHeight = node.height
    else if rodash.isNonEmptyAA(boundingRect)
        nodeHeight = boundingRect.height
    end if

    nodeHeight += nodeMargins.top
    nodeHeight += nodeMargins.bottom

    return nodeHeight
end function

function getVisibleWidth(node)
    if not rodash.isNode(node) then return 0

    nodeWidth = 0
    clippingRect = node.clippingRect
    boundingRect = node.boundingRect()
    nodeMargins = quadrupleMargins(node.margin)

    if not node.visible then return 0
    if not rodash.isNonEmptyAA(clippingRect) then return 0

    if clippingRect.width > 0
        nodeWidth = clippingRect.width
    else if rodash.isNumber(node.width) and node.width > 0
        nodeWidth = node.width
    else if rodash.isNonEmptyAA(boundingRect)
        nodeWidth = boundingRect.width
    end if

    nodeWidth += nodeMargins.left
    nodeWidth += nodeMargins.right

    return nodeWidth
end function
