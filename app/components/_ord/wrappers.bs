    if interface = invalid then return invalid
    return interface.getVisibleHeight(node)
end function


function getVisibleWidth(node = top())
    interface = m.ord_interfaces["getVisibleWidth"]
    if interface = invalid then return invalid
    return interface.getVisibleWidth(node)
end function


function quadrupleMargins(options = 0)
    interface = m.ord_interfaces["quadrupleMargins"]
    if interface = invalid then return invalid
    return interface.quadrupleMargins(options)
end function


function stackChildren(options = {}, node = top())
    interface = m.ord_interfaces["stackChildren"]
    if interface = invalid then return invalid
    return interface.stackChildren(options, node)
end function


function top()
    return getGlobalAA().top
end function


function global()
    return getGlobalAA().global
end function


function runTask()
    if not rodash.isFunction(m._ord_taskFunction) then return invalid
    return exec(m._ord_taskFunction)
end function


function onError(e)
    'bs:disable-next-line
    ?"ERROR: " formatJSON(e)
    return invalid
end function


