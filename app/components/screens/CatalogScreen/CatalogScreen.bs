import "pkg:/components/_ord/wrappers.bs"
import "pkg:/source/roku_modules/promises/promises.brs"

sub init()
    exec(sub(options = {})
        m.screenContainer = top().findNode("screenContainer")
        m.headerContainer = top().findNode("headerContainer")
        m.scrollGroup = top().findNode("scrollGroup")

        ' m.screenContainer.color = "#00000000"
        ' ?"m.screenContainer " m.screenContainer.color

        m.scrollGroup.config = {
            direction: "vertical",
            flushEnd: true,
            showScrollbar: false
        }

        safeObserve("data", onDataSet)
        ' rodash.delay(sub(node)
        '     newRect = createObject("roSGNode", "Rectangle")
        '     newRect.width = 1650
        '     newRect.height = 400
        '     newRect.color = "#0000FFFF"

        '     newRect2 = createObject("roSGNode", "Rectangle")
        '     newRect2.width = 1650
        '     newRect2.height = 200
        '     newRect2.color = "#FF00FFFF"
        '     node.appendChildren([newRect, newRect2])
        '     ' node.appendChild(newRect)
        ' end sub, 3000, m.scrollGroup)
    end sub)
end sub


function handleFocus(options = {})
    return exec(function(options = {})
        m.scrollGroup.setFocus(true)
        return true
    end function)
end function


sub onDataSet(options = {})
    if not rodash.isNonEmptyAA(options) then return

    data = options.data
    content = data.content
    headerContent = content.getChild(0)

    for each model in content.getChildren(-1, 0)
        processScrollItem({ model: model })
    end for
end sub


sub processScrollItem(options = {})
    if not rodash.isNonEmptyAA(options) then return

    model = options.model
    carouselType = model.carouselType ?? "INDEX"

    if carouselType = "Hero"
        component = createObject("roSGNode", "Hero")
        m.headerContainer.appendChild(component)
    else
        component = createObject("roSGNode", "Carousel")
        component.data = { content: model }
        m.scrollGroup.appendChild(component)
    end if

    stackChildren({ node: m.screenContainer, direction: "vertical" })

end sub
