import "pkg:/components/_ord/wrappers.bs"
import "pkg:/source/roku_modules/promises/promises.brs"

sub init()
    exec(sub(_options = {})
        safeObserve("data", onDataSet)
        m.modalContainer = top().findNode("modalContainer")
        m.detailsScrollGroup = top().findNode("detailsScrollGroup")

        liveConfig({ field: "config", keyPath: "DetailsScrollGroup" }, m.detailsScrollGroup)

        setFocusMap({
            "onFocus": m.detailsScrollGroup,
            "detailsScrollGroup": {
                "default": true,
                "back": false
            }
        })

        styleHooks({
            after: afterStyling
        })
    end sub)
end sub


sub afterStyling(_options = {})
    stackChildren({ node: m.modalContainer, direction: "vertical" })
    centerComponent({ node: m.modalContainer, horizontal: true, vertical: true })
end sub


sub onDataSet(options = {})
    data = options.data
    model = data.content
    creditsCollection = exec("returnCreditsCollection", {}, model)
    if not rodash.isNode(creditsCollection) then return

    for each model in creditsCollection.getChildren(-1, 0)
        processScrollItem({ model: model })
    end for

    afterStyling()
end sub


sub processScrollItem(options = {})
    if not rodash.isNonEmptyAA(options) then return

    model = options.model
    if not rodash.isNode(model) then return

    component = createObject("roSGNode", "Credit")
    component.data = { content: model }
    m.detailsScrollGroup.appendChild(component)
end sub


' Methods exteded from sgRouter

function beforeViewClose(_options = {})
    suspendPromise = promises.create()
    fadeOut(top(), { duration: 0.3, callback: onViewFadedOut, callbackOptions: { promise: suspendPromise }})
    return suspendPromise
end function


function beforeViewOpen(options = {}) as dynamic
    if not rodash.isNonEmptyAA(options) then return invalid

    top().opacity = 0.001
    fadeIn(top(), { duration: 0.5 })

    route = options.route ?? {}
    context = route.context ?? {}
    content = context.content

    if rodash.isNode(content) then top().data = { content: content }
    return promises.resolve(invalid)
end function


sub onViewFadedOut(options = {})
    if not rodash.isNonEmptyAA(options) then return
    suspendPromise = options.promise
    promises.resolve(true, suspendPromise)
end sub
