import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub(options = {})
        setTaskFunction(runScreenTask)
        ' Needed to circumvent a Roku bug with callFunc
        m.containerNode = createObject("roSGNode", "Node")
    end sub)
end sub


function runScreenTask(options = {})
    collection = top().collection
    if not rodash.isNode(collection) then return true

    variables = exec("getVariables", {}, collection)
    if rodash.isEmpty(variables) then return true

    response = rokurequests_Requests().post("<%- s(CONFIG.ENV.GRAPHQL_SERVER) %>", { json: { query: "<%- s(QUERY.Screen) %>", variables: variables }, headers: "<%- o(CONFIG.Headers) %>"})

    if rodash.isEmpty(response.text) then return true

    updateObject = returnUpdateObject(parseJSON(response.text))
    collection.update(updateObject, true)
    collection.totalCount = collection.getChildCount()

    publish(events.SCREEN_DATA_RECEIVED, {
        content: collection
    })

    return true
end function


function returnUpdateObject(options = {})
    data = options.data ?? {}
    screenData = data.screen ?? {}
    ' carouselsData = screenData.carousels ?? []
    ' carouselsData =  [screenData.carousels[3], screenData.carousels[4], screenData.carousels[5]]
    carouselsData =  [screenData.carousels[0], screenData.carousels[1]]
    updateObjArray = []

    for each carousel in carouselsData
        carouselModel = createObject("roSGNode", "Collection")
        thumbnailType = carousel.thumbnailType ?? "LANDSCAPE"

        updateObject = {
            carouselTitle: carousel.carouselTitle,
            carouselType: carousel.carouselType,
            documentId: carousel.documentId,
            id: carousel.documentId,
            thumbnailType: thumbnailType
        }

        configKey = thumbnailType = "LANDSCAPE" ? "LandscapeCarousel" : "PortraitCarousel"
        carouselConfig = liveConfig({ field: "config", keyPath: configKey }, carouselModel)

        updateObject.children = []

        ' Load initial carousel items
        ' for loading animation
        for x = 0 to carouselConfig.visibleTiles - 1
            updateObject.children.push({
                description: "",
                hydrated: false,
                logoImageUri: "",
                observed: false,
                subtype: "ContentModel",
                thumbnailImageUri: ""
            })
        end for

        carouselModel.update(updateObject, true)

        updateObjArray.push(carouselModel)
    end for

    updateObject = {
        canPaginate: not rodash.isEmpty(updateObjArray),
        children: updateObjArray,
        documentId: screenData.documentId,
        slug: screenData.slug,
        paginating: false
    }

    ' model = createObject("roSGNode", "Collection")
    ' model.appendChildren(updateObjArray)
    ' model.update(updateObject, true)

    return updateObject
end function
