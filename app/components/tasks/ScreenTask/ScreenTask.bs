import "pkg:/components/_ord/wrappers.bs"
import "pkg:/components/tasks/shared/carousels.bs"
import "pkg:/components/tasks/shared/content.bs"

sub init()
    exec(sub(options = {})
        setTaskFunction(runScreenTask)
        ' Needed to circumvent a Roku bug with callFunc
        m.containerNode = createObject("roSGNode", "Node")
    end sub)
end sub


function runScreenTask(options = {})
    options = top().options ?? {}
    if not rodash.isNonEmptyAA(options) then return true

    collection = options.collection
    if not rodash.isNode(collection) then return true

    variables = exec("getVariables", {}, collection)
    if rodash.isEmpty(variables) then return true

    response = rokurequests_Requests().post("<%- s(CONFIG.ENV.GRAPHQL_SERVER) %>", { json: { query: "<%- s(QUERY.Screen) %>", variables: variables }, headers: "<%- o(CONFIG.Headers) %>"})

    if rodash.isEmpty(response.text) then return true

    responseJSON = parseJSON(response.text)
    data = responseJSON.data ?? {}
    screenData = data.screen ?? {}
    carouselsArray = screenData.carousels ?? []
    ' carouselsArray =  [screenData.carousels[3], screenData.carousels[4], screenData.carousels[5]]
    ' carouselsArray =  [screenData.carousels[0], screenData.carousels[2]]
    updateObject = returnCarouselsArray(carouselsArray)
    updateObject.append({
        documentId: screenData.documentId,
        slug: screenData.slug
    })
    collection.update(updateObject, true)
    collection.totalCount = collection.getChildCount()

    publish(events.SCREEN_DATA_RECEIVED, {
        content: collection
    })

    return true
end function
