import "pkg:/components/_ord/wrappers.bs"

sub init()
    exec(sub(options = {})
        setTaskFunction(runScreenTask)
    end sub)
end sub


function runScreenTask(options = {})
    screenVariables = top().screenVariables
    response = rokurequests_Requests().post("<%- s(CONFIG.ENV.GRAPHQL_SERVER) %>", { json: { query: "<%- s(QUERY.Screen) %>", variables: screenVariables }, headers: "<%- o(CONFIG.Headers) %>"})

    if rodash.isEmpty(response.text) then return true

    screenModel = returnScreenModel(parseJSON(response.text))

    if rodash.isNode(screenModel)
        publish(events.SCREEN_DATA_RECEIVED, { content: screenModel })
    end if

    return true
end function


function returnScreenModel(options = {})
    data = options.data ?? {}
    screenData = data.screen ?? {}
    carouselsData = screenData.carousels ?? []
    updateObjArray = []

    for each carousel in carouselsData
        updateObject = {
            carouselTitle: carousel.carouselTitle,
            carouselType: carousel.carouselType,
            documentId: carousel.documentId,
            id: carousel.documentId,
            thumbnailType: carousel.thumbnailType ?? "LANDSCAPE",
            subtype: "Model"
        }

        updateObjArray.push(updateObject)
    end for

    updateObject = {
        slug: screenData.slug,
        children: updateObjArray
    }

    model = createObject("roSGNode", "Model")
    model.update(updateObject, true)

    return model
end function


