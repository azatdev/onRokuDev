{
  "name": "onRokuDev",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "npm@10.9.3",
  "ropm": {
    "rootDir": "app"
  },
  "scripts": {
    "postinstall": "ropm copy",
    "dev": "concurrently --kill-others-on-fail --names socket,web,styles,configs,graphql --prefix-colors yellow,blue,green,magenta,cyan \"npm run socketserver\" \"npm run webserver\" \"npm run watch:styles\" \"npm run watch:configs\" \"npm run watch:graphql\"",
    "webserver": "node scripts/webserver.js",
    "socketserver": "node scripts/socketserver.js",
    "build:configs": "node scripts/generate-configs.cjs",
    "build:graphql": "node scripts/generate-graphql.cjs",
    "build:styles": "node scripts/generate-styles.cjs",
    "watch:configs": "node scripts/watch-configs.js",
    "watch:graphql": "node scripts/watch-graphql.js",
    "watch:styles": "node scripts/watch-styles.js",
    "pretranspile": "npm run build:styles && npm run build:configs && npm run build:graphql",
    "transpile": "npx ts-node scripts/generate-brs.ts",
    "test": "npm run test:rooibos:build",
    "test:rooibos:build": "node scripts/run-rooibos.cjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@rokucommunity/bslint": "^0.8.41",
    "brighterscript": "^0.71.0",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.2",
    "ejs": "^5.0.1",
    "promises": "npm:@rokucommunity/promises@^0.7.0",
    "rodash": "npm:@tkss/rodash@^0.0.37",
    "roku-requests": "^1.2.0",
    "sgRouter": "https://github.com/rokucommunity/sgRouter/releases/download/v0.0.0-packages/rokucommunity-sgrouter-0.1.4-refined-navivation-control-and-AI-supporting-documents.20260703165006.tgz",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@graphql-tools/graphql-file-loader": "^8.1.14",
    "@graphql-tools/load": "^8.1.10",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "concurrently": "^9.2.1",
    "fs-extra": "^11.3.4",
    "graphql": "^16.14.0",
    "rooibos-roku": "^5.16.1",
    "ropm": "^0.11.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
