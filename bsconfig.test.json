{
    "extends": "./bsconfig.json",
    "createPackage": true,
    "files": [
        "components/**/*",
        "manifest",
        "static/**/*",
        "source/**/*",
        "!source/main.brs",
        {
            "src": "tests/source/main.brs",
            "dest": "source/main.brs"
        },
        {
            "src": "tests/ord_flexList.spec.bs",
            "dest": "source/tests/ord_flexList.spec.bs"
        }
    ],
    "outFile": "out/rooibos-tests.zip",
    "plugins": [
        "./build/ejsParser.ts",
        "@rokucommunity/bslint",
        "rooibos-roku"
    ],
    "rooibos": {
        "catchCrashes": true,
        "failFast": true,
        "includeFilters": [
            "**/*.spec.bs",
            "!**/roku_modules/**/*"
        ],
        "reporters": [ "console" ],
        "showOnlyFailures": false
    }
}
