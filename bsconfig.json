{
    "createPackage": false,
    "diagnosticLevel": "error",
    "diagnosticFilters": [
        "**/TrackerTask.xml",
        "./source/roku_modules/**/*",
        "./components/roku_modules/**/*",
        "./tests/**/*"
    ],
    "files": [
        "components/**/*",
        "manifest",
        "static/**/*",
        "source/**/*"
    ],
    "lintConfig": "config/bslint.jsonc",
    "outputDir": "out",
    "plugins": [ "@rokucommunity/bslint" ],
    "rootDir": "app",
    "sourceMap": true,
    "stagingDir": "transpiled/build",
    "configsPath": "build/configs.json",
    "queryPath": "build/query.json",
    "stylesPath": "build/styles.json"
}
