{
    "createPackage": false,
    "diagnosticLevel": "error",
    "diagnosticFilters": [
        "**/TrackerTask.xml",
        "./source/roku_modules/**/*",
        "./components/roku_modules/**/*",
        "./tests/**/*",
        "./locale/**/*"
    ],
    "files": [
        "assets/**/*",
        "components/**/*",
        "locale/**/*",
        "manifest",
        "source/**/*"
    ],
    "lintConfig": "bslint.jsonc",
    "outputDir": "out",
    "require": [
        "ts-node/register"
    ],
    "plugins": [
        "./scripts/ejsParser.ts",
        "@rokucommunity/bslint"
    ],
    "rootDir": "app",
    "sourceMap": true,
    "stagingDir": "transpiled/build",
    "configsPath": "scripts/configs.json",
    "queryPath": "scripts/query.json",
    "stylesPath": "scripts/styles.json"
}
